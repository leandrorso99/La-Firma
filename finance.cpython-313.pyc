    def stock_adjusted_items_text(self, adjusted_items: dict[str, Any]) -> str:
        if not adjusted_items:
            return 'Nenhum item precisou de ajuste.'
        parts = [f'{self.stock_item_label(item)}: {int(quantity or 0)}' for item, quantity in adjusted_items.items()]
        return ' | '.join(parts)

    def stock_scope_audit_fields(self, scope: str, adjusted_items: dict[str, Any], balance: dict[str, Any]) -> list[tuple[str, str, bool]]:
        fields: list[tuple[str, str, bool]] = [
            ('Escopo', self.stock_scope_name(scope), True),
            ('Itens ajustados', self.stock_adjusted_items_text(adjusted_items), False),
        ]
        if scope == 'all':
            fields.extend([
                ('Saldo Membros', self.stock_target_balance_text('members', balance), False),
                ('Saldo Favela', self.stock_target_balance_text('favela', balance), False),
                ('Saldo Bangalô', self.stock_target_balance_text('bangalo', balance), False),
                ('Saldo Bangalô 2', self.stock_target_balance_text('bangalo2', balance), False),
                ('Saldo Mansões', self.stock_target_balance_text('mansoes', balance), False),
            ])
            return fields

        fields.append(('Saldo atual', self.stock_target_balance_text(scope, balance), False))
        return fields

    def manager_modal_title(self, target: str) -> str:
        titles = {
            'members': 'Registrar Estoque Bangalô Membros',
            'favela': 'Registrar Estoque Favela',
            'bangalo': 'Registrar Estoque Bangalô Gerência',
            'bangalo2': 'Registrar Estoque Bangalô 2 Gerência',
            'mansoes': 'Registrar Estoque Mansões',
        }
        return titles.get(target, 'Registrar Estoque')

    def transfer_target_name(self, source_scope: str) -> str:
        labels = {
            'members': 'Bangalô Membros',
            'favela': 'Baú da Favela',
            'bangalo': 'Bangalô Estoque Gerência',
            'bangalo2': 'Bangalô 2 Estoque Gerência',
            'mansoes': 'Baú de Mansões',
        }
        return labels.get(source_scope, 'Baú')

    def transfer_quantities_text(self, quantities: dict[str, Any]) -> str:
        parts = []
        labels = [
            ('cocaina', 'Cocaína'),
            ('metanfetamina', 'Metanfetamina'),
            ('comum', 'Comum'),
            ('incomum', 'Incomum'),
            ('raro', 'Raro'),
            ('mitica', 'Mítica'),
            ('lendaria', 'Lendária'),
        ]
        for field, label in labels:
            quantity = int(quantities.get(field, 0) or 0)
            if quantity > 0:
                parts.append(f'{label}: {quantity}')
        return ' | '.join(parts) if parts else 'Nenhum item transferido.'

