class WeeklyHistoryView(discord.ui.View):
    def __init__(self, cog: 'StockCog', owner_user_id: int, pages: list[str]) -> None:
        super().__init__(timeout=300)
        self.cog = cog
        self.owner_user_id = owner_user_id
        self.pages = pages
        self.index = 0
        self._sync_buttons()

    def can_use(self, interaction: discord.Interaction) -> bool:
        return interaction.user.id == self.owner_user_id

    def _sync_buttons(self) -> None:
        self.previous_button.disabled = self.index <= 0
        self.next_button.disabled = self.index >= len(self.pages) - 1

    def current_embed(self) -> discord.Embed:
        embed = discord.Embed(
            title=f'📊 Painel Financeiro e Estoque - Pág {self.index + 1}/{len(self.pages)}',
            description=self.pages[self.index],
            color=0xF1C40F,
        )
        return embed

    @discord.ui.button(label='◀ Anterior', style=discord.ButtonStyle.secondary)
    async def previous_button(self, interaction: discord.Interaction, button: discord.ui.Button) -> None:
        if not self.can_use(interaction):
            await interaction.response.send_message('Esse painel pertence a outra pessoa.', ephemeral=True)
            return
        self.index = max(0, self.index - 1)
        self._sync_buttons()
        await interaction.response.edit_message(embed=self.current_embed(), view=self)

    @discord.ui.button(label='Próximo ▶', style=discord.ButtonStyle.secondary)
    async def next_button(self, interaction: discord.Interaction, button: discord.ui.Button) -> None:
        if not self.can_use(interaction):
            await interaction.response.send_message('Esse painel pertence a outra pessoa.', ephemeral=True)
            return
        self.index = min(len(self.pages) - 1, self.index + 1)
        self._sync_buttons()
        await interaction.response.edit_message(embed=self.current_embed(), view=self)

    @discord.ui.button(label='🗑 Zerar Estoque', style=discord.ButtonStyle.danger)
    async def reset_button(self, interaction: discord.Interaction, button: discord.ui.Button) -> None:
        if not self.can_use(interaction):
            await interaction.response.send_message('Esse painel pertence a outra pessoa.', ephemeral=True)
            return
        await interaction.response.send_message(
            'Escolha qual estoque deseja zerar.',
            view=StockResetScopeView(self.cog, self.owner_user_id),
            ephemeral=True,
        )


class StockCog(commands.Cog):
    def __init__(self, bot: commands.Bot) -> None:
        self.bot = bot
        self.api = FinanceApiClient()
        self.pending_transfer_requests: dict[int, dict[str, Any]] = {}
        self.pending_sample_requests: dict[int, dict[str, Any]] = {}
        self.pending_member_withdrawals: dict[int, dict[str, Any]] = {}
        self.pending_member_withdrawal_prompts: dict[tuple[int, int], discord.Message | discord.InteractionMessage | discord.WebhookMessage] = {}
        self.pending_members_deposits: dict[int, dict[str, Any]] = {}
        self.pending_favela_deposits: dict[int, dict[str, Any]] = {}
        self.pending_mansoes_deposits: dict[int, dict[str, Any]] = {}
        self.pending_bangalo_deposits: dict[int, dict[str, Any]] = {}
        self.pending_bangalo2_deposits: dict[int, dict[str, Any]] = {}
        self.guild_object = None
        guild_id = int(getattr(config, 'GUILD_ID', 0) or 0)
        if guild_id > 0:
            self.guild_object = discord.Object(id=guild_id)

    async def cog_load(self) -> None:
        self.bot.add_view(StockPanelView(self))
        self.bot.add_view(StockTicketView(self))

    async def cog_unload(self) -> None:
        await self.api.close()

    def audit_log_delete_after(self) -> float | None:
        raw_value = getattr(config, 'STOCK_LOG_DELETE_AFTER_SECONDS', 600)
        try:
            seconds = float(raw_value)
        except (TypeError, ValueError):
            seconds = 600.0

        if seconds <= 0:
            return None

        return seconds

    def ephemeral_delete_after(self) -> float | None:
        raw_value = getattr(config, 'STOCK_EPHEMERAL_DELETE_AFTER_SECONDS', 120)
        try:
            seconds = float(raw_value)
        except (TypeError, ValueError):
            seconds = 120.0

        if seconds <= 0:
            return None

        return seconds

    def stock_action_error_message(self, action_label: str, error: Exception) -> str:
        raw_message = str(error).strip() or 'erro desconhecido.'
        normalized = raw_message.casefold()

        if 'não existe ticket aberto vinculado a este canal' in normalized:
            return (
                f'Falha ao {action_label}: este canal não está vinculado a um ticket aberto no site.\n'
                'Abra um ticket novo pelo painel de retirada e faça o lançamento dentro do ticket.'
            )

        if 'somente o dono do ticket pode registrar a retirada' in normalized or 'somente o dono do ticket pode registrar a amostra' in normalized:
            return (
                f'Falha ao {action_label}: apenas o dono do ticket pode concluir esse lançamento.\n'
                'Peça para o próprio membro registrar no ticket dele.'
            )

        if 'dados obrigatórios da retirada não foram enviados' in normalized:
            return (
                f'Falha ao {action_label}: dados obrigatórios não chegaram na API.\n'
                'Feche este fluxo e tente registrar novamente pelo botão do ticket.'
            )

        if 'dados obrigatórios da amostra não foram enviados' in normalized:
            return (
                f'Falha ao {action_label}: dados obrigatórios da amostra não chegaram na API.\n'
                'Abra o fluxo de amostra novamente no ticket e confirme os campos.'
            )

        return f'Falha ao {action_label}: {raw_message}'

    async def delete_message_later(self, message: discord.Message | discord.InteractionMessage | discord.WebhookMessage | None, delay: float | None) -> None:
        if message is None or delay is None:
            return

        try:
            await asyncio.sleep(delay)
            await message.delete()
        except (discord.NotFound, discord.Forbidden, discord.HTTPException):
            return

    async def send_ephemeral_message(
        self,
        interaction: discord.Interaction,
        *,
        content: str | None = None,
        embed: discord.Embed | None = None,
        view: discord.ui.View | None = None,
    ) -> None:
        delete_after = self.ephemeral_delete_after()
        kwargs: dict[str, Any] = {'ephemeral': True}

        if content is not None:
            kwargs['content'] = content
        if embed is not None:
            kwargs['embed'] = embed
        if view is not None:
            kwargs['view'] = view

        if interaction.response.is_done():
            try:
                message = await interaction.followup.send(wait=True, **kwargs)
            except Exception as exc:
                if is_ignorable_discord_http(exc):
                    return
                raise
            if message is None:
                return
            if delete_after is not None:
                asyncio.create_task(self.delete_message_later(message, delete_after))
            return

        try:
            await interaction.response.send_message(**kwargs)
        except Exception as exc:
            if not is_ignorable_discord_http(exc):
                raise
            try:
                message = await interaction.followup.send(wait=True, **kwargs)
            except Exception as followup_exc:
                if is_ignorable_discord_http(followup_exc):
                    return
                raise
            if message is None:
                return
            if delete_after is not None:
                asyncio.create_task(self.delete_message_later(message, delete_after))
            return
        if delete_after is not None:
            try:
                message = await interaction.original_response()
            except (discord.NotFound, discord.HTTPException):
                return
            asyncio.create_task(self.delete_message_later(message, delete_after))

    async def send_modal_safely(self, interaction: discord.Interaction, modal: discord.ui.Modal) -> bool:
        if interaction.response.is_done():
            await self.send_ephemeral_message(
                interaction,
                content='Essa interação já expirou. Clique no botão novamente para abrir o formulário.',
            )
            return False
        try:
            await interaction.response.send_modal(modal)
            return True
        except Exception as exc:
            if is_ignorable_discord_http(exc):
                await self.send_ephemeral_message(
                    interaction,
                    content='Essa interação já expirou. Clique no botão novamente para abrir o formulário.',
                )
                return False
            raise

    async def defer_ephemeral_safely(self, interaction: discord.Interaction, *, thinking: bool = False) -> bool:
        if interaction.response.is_done():
            return True

        try:
            await interaction.response.defer(ephemeral=True, thinking=thinking)
            return True
        except Exception as exc:
            if is_ignorable_discord_http(exc):
                return False
            raise

    def manager_role_ids(self) -> set[int]:
        return role_ids_from_config('STOCK_MANAGER_ROLE_IDS')

    def support_role_ids(self) -> set[int]:
        return role_ids_from_config('STOCK_SUPPORT_ROLE_IDS') | self.manager_role_ids() | self.close_role_ids()

