    def member_withdrawal_prompt_key(self, user_id: int, channel_id: int | None) -> tuple[int, int] | None:
        if channel_id is None:
            return None
        return (user_id, int(channel_id))

    def store_member_withdrawal_prompt(
        self,
        user_id: int,
        channel_id: int | None,
        message: discord.Message | discord.InteractionMessage | discord.WebhookMessage,
    ) -> None:
        key = self.member_withdrawal_prompt_key(user_id, channel_id)
        if key is None:
            return
        self.pending_member_withdrawal_prompts[key] = message

    def discard_member_withdrawal_prompt(self, user_id: int, channel_id: int | None) -> None:
        key = self.member_withdrawal_prompt_key(user_id, channel_id)
        if key is None:
            return
        self.pending_member_withdrawal_prompts.pop(key, None)

    async def clear_member_withdrawal_prompt(self, user_id: int, channel_id: int | None, *, content: str | None = None) -> None:
        key = self.member_withdrawal_prompt_key(user_id, channel_id)
        if key is None:
            return
        message = self.pending_member_withdrawal_prompts.pop(key, None)
        if message is None:
            return
        try:
            await message.edit(content=content or 'Seleção de tipo de maconha expirada.', view=None)
        except Exception as exc:
            if is_ignorable_discord_http(exc):
                return
            raise

    async def finalize_pending_sample_request(self, interaction: discord.Interaction, owner_user_id: int) -> None:
        request = self.pop_pending_sample_request(owner_user_id)
        if request is None:
            if interaction.response.is_done():
                await self.send_ephemeral_message(interaction, content='Registro de amostra expirado.')
            else:
                await interaction.response.send_message('Registro de amostra expirado.', ephemeral=True)
            return

        items = request.get('items', []) if isinstance(request.get('items'), list) else []
        if not items:
            self.store_pending_sample_request(owner_user_id, request)
            if interaction.response.is_done():
                await self.send_ephemeral_message(interaction, content='Adicione pelo menos um item antes de finalizar.', view=SampleBuilderView(self, owner_user_id))
            else:
                await interaction.response.send_message('Adicione pelo menos um item antes de finalizar.', ephemeral=True)
            return

        payload = {
            'source': 'discord',
            'autor': interaction.user.display_name,
            'autor_discord_id': str(interaction.user.id),
            'ticket_channel_id': str(interaction.channel_id),
            'member_name': str(request.get('member_name', '')).strip(),
            'observacao': str(request.get('observacao', '')).strip(),
            'items': items,
        }

        if not interaction.response.is_done():
            deferred = await self.defer_ephemeral_safely(interaction)
            if not deferred:
                self.store_pending_sample_request(owner_user_id, request)
                return

        try:
            await self.handle_member_sample(interaction, payload)
        except FinanceApiError as exc:
            self.store_pending_sample_request(owner_user_id, request)
            await self.send_ephemeral_message(
                interaction,
                content=self.stock_action_error_message('registrar a amostra', exc) + '\n\nA amostra continua montada para nova tentativa.',
                view=SampleBuilderView(self, owner_user_id),
            )

    def sample_builder_content(self, request: dict[str, Any], prefix: str | None = None) -> str:
        member_name = str(request.get('member_name', 'Membro')).strip() or 'Membro'
        observation = str(request.get('observacao', '')).strip()
        items = request.get('items', []) if isinstance(request.get('items'), list) else []

        lines = [f'Membro: {member_name}']
        if observation:
            lines.append(f'Observação: {observation}')

        if items:
            lines.append('Itens atuais:')
            for index, item in enumerate(items, start=1):
                label = str(item.get('label', '')).strip()
                if not label:
                    drug_label = {
                        'maconha': 'Maconha',
                        'cocaina': 'Cocaína',
                        'metanfetamina': 'Metanfetamina',
                    }.get(str(item.get('drug_type', '')), 'Droga')
                    quantity = int(item.get('quantity', 0) or 0)
                    parts = [f'{drug_label} {quantity}']
                    rarity = str(item.get('rarity', '')).strip()
                    source_scope = str(item.get('source_scope', '')).strip()
                    if rarity:
                        parts.append(rarity.title())
                    if source_scope:
                        parts.append(self.stock_scope_name(source_scope))
                    label = ' | '.join(parts)
                lines.append(f'{index}. {label}')
        else:
            lines.append('Nenhum item adicionado ainda.')

        content = '\n'.join(lines)
        if prefix:
            return f'{prefix}\n\n{content}'
        return content

