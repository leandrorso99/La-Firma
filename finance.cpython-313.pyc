LOGGER = logging.getLogger(__name__)


def money_text(value: float) -> str:
    return f'R$ {value:,.2f}'.replace(',', 'X').replace('.', ',').replace('X', '.')


def parse_int_input(raw: str) -> int:
    value = raw.strip()
    if value == '':
        return 0
    parsed = int(value)
    if parsed < 0:
        raise ValueError('Quantidade não pode ser negativa.')
    return parsed


def role_ids_from_config(name: str) -> set[int]:
    values = getattr(config, name, []) or []
    parsed: set[int] = set()
    for value in values:
        try:
            role_id = int(value)
        except (TypeError, ValueError):
            continue
        if role_id > 0:
            parsed.add(role_id)
    return parsed


def has_any_role(member: discord.Member, role_ids: set[int]) -> bool:
    if not role_ids:
        return False
    return any(role.id in role_ids for role in member.roles)


def sanitize_channel_name(raw: str) -> str:
    value = raw.strip().lower()
    value = re.sub(r'[^a-z0-9]+', '-', value)
    value = re.sub(r'-{2,}', '-', value).strip('-')
    if not value:
        value = 'membro'
    return value[:70]


def normalize_category_name(raw: str) -> str:
    value = raw.strip().lower()
    value = re.sub(r'\s+', ' ', value)
    return value


def is_ignorable_discord_http(error: Exception) -> bool:
    if isinstance(error, discord.NotFound):
        return True
    if isinstance(error, discord.HTTPException):
        return getattr(error, 'code', None) in {10003, 10062, 40060, 50027}
    return False


class ManagerDepositModal(discord.ui.Modal):
    def __init__(self, cog: 'StockCog', target: str = 'members') -> None:
        super().__init__(title=cog.manager_modal_title(target))
        self.cog = cog
        self.target = target
        self.inputs: dict[str, discord.ui.TextInput] = {}

        for field_key, field_label in cog.manager_modal_fields(target):
            input_item = discord.ui.TextInput(label=field_label, placeholder='0', required=False, max_length=10, default='0')
            self.inputs[field_key] = input_item
            self.add_item(input_item)

        self.observacao: discord.ui.TextInput | None = None
        if target == 'members':
            self.observacao = discord.ui.TextInput(
                label='Observação',
                placeholder='Ex: Reposição do baú da semana',
                required=False,
                max_length=200,
                style=discord.TextStyle.long,
            )
            self.add_item(self.observacao)

    async def on_submit(self, interaction: discord.Interaction) -> None:
        try:
            payload = {
                'autor': interaction.user.display_name,
                'autor_discord_id': str(interaction.user.id),
            }

            for field_key, input_item in self.inputs.items():
                payload[field_key] = parse_int_input(str(input_item))

            if self.observacao is not None:
                payload['observacao'] = str(self.observacao).strip()
            else:
                payload['observacao'] = f'Entrada registrada via Discord no estoque de {self.cog.stock_target_name(self.target).lower()}'

            await self.cog.handle_manager_deposit(interaction, payload, self.target)
        except ValueError as exc:
            await interaction.response.send_message(f'Entrada inválida: {exc}', ephemeral=True)
        except FinanceApiError as exc:
            if interaction.response.is_done():
                await interaction.followup.send(f'Falha ao registrar entrada: {exc}', ephemeral=True)
            else:
                await interaction.response.send_message(f'Falha ao registrar entrada: {exc}', ephemeral=True)


class CannabisRaritySelect(discord.ui.Select):
    def __init__(self, cog: 'StockCog', owner_user_id: int) -> None:
        options = [
            discord.SelectOption(label='Incomum', value='incomum', description='Converter a maconha em Incomum'),
            discord.SelectOption(label='Raro', value='raro', description='Converter a maconha em Raro'),
            discord.SelectOption(label='Mítica', value='mitica', description='Converter a maconha em Mítica'),
            discord.SelectOption(label='Lendária', value='lendaria', description='Converter a maconha em Lendária'),
        ]
        super().__init__(placeholder='Selecione o tipo da maconha', min_values=1, max_values=1, options=options)
        self.cog = cog
        self.owner_user_id = owner_user_id

    async def callback(self, interaction: discord.Interaction) -> None:
        if interaction.user.id != self.owner_user_id:
            await interaction.response.send_message('Esse fluxo pertence a outra pessoa.', ephemeral=True)
            return
        await self.cog.finalize_pending_transfer(interaction, self.values[0])


class CannabisRaritySelectView(discord.ui.View):
