class Bangalo2DepositStepTwoModal(discord.ui.Modal):
    def __init__(self, cog: 'StockCog') -> None:
        super().__init__(title='Registrar Bangalô 2 2/2')
        self.cog = cog

        self.raro = discord.ui.TextInput(label='Raro', placeholder='0', required=False, max_length=10, default='0')
        self.mitica = discord.ui.TextInput(label='Mítica', placeholder='0', required=False, max_length=10, default='0')
        self.lendaria = discord.ui.TextInput(label='Lendária', placeholder='0', required=False, max_length=10, default='0')
        self.observacao = discord.ui.TextInput(
            label='Observação',
            placeholder='Ex: Reposição semanal do Bangalô 2',
            required=False,
            max_length=200,
            style=discord.TextStyle.long,
        )

        self.add_item(self.raro)
        self.add_item(self.mitica)
        self.add_item(self.lendaria)
        self.add_item(self.observacao)

    async def on_submit(self, interaction: discord.Interaction) -> None:
        pending = self.cog.pop_pending_bangalo2_payload(interaction.user.id)
        if pending is None:
            await interaction.response.send_message('A primeira etapa expirou. Abra o fluxo do Bangalô 2 novamente.', ephemeral=True)
            return

        try:
            payload = dict(pending)
            payload.update({
                'autor': interaction.user.display_name,
                'autor_discord_id': str(interaction.user.id),
                'bangalo2_raro': parse_int_input(str(self.raro)),
                'bangalo2_mitica': parse_int_input(str(self.mitica)),
                'bangalo2_lendaria': parse_int_input(str(self.lendaria)),
                'observacao': str(self.observacao).strip() or 'Entrada registrada via Discord no estoque do bangalô 2 gerência',
            })
            await self.cog.handle_manager_deposit(interaction, payload, 'bangalo2')
        except ValueError as exc:
            self.cog.store_pending_bangalo2_payload(interaction.user.id, pending)
            await interaction.response.send_message(f'Entrada inválida: {exc}', ephemeral=True)
        except FinanceApiError:
            self.cog.store_pending_bangalo2_payload(interaction.user.id, pending)
            raise


class MembersDepositStepTwoLauncherView(discord.ui.View):
    def __init__(self, cog: 'StockCog', owner_user_id: int) -> None:
        super().__init__(timeout=300)
        self.cog = cog
        self.owner_user_id = owner_user_id

    def can_use(self, interaction: discord.Interaction) -> bool:
        return interaction.user.id == self.owner_user_id

    @discord.ui.button(label='Continuar Membros', style=discord.ButtonStyle.success, emoji='🧰')
    async def continue_button(self, interaction: discord.Interaction, button: discord.ui.Button) -> None:
        if not self.can_use(interaction):
            await interaction.response.send_message('Esse fluxo pertence a outra pessoa.', ephemeral=True)
            return
        await interaction.response.send_modal(MembersDepositStepTwoModal(self.cog))

    @discord.ui.button(label='Cancelar', style=discord.ButtonStyle.secondary, emoji='✖')
    async def cancel_button(self, interaction: discord.Interaction, button: discord.ui.Button) -> None:
        if not self.can_use(interaction):
            await interaction.response.send_message('Esse fluxo pertence a outra pessoa.', ephemeral=True)
            return
        self.cog.discard_pending_members_payload(interaction.user.id)
        await interaction.response.edit_message(content='Lançamento do bangalô membros cancelado.', view=None)


class MembersDepositStepOneModal(discord.ui.Modal):
    def __init__(self, cog: 'StockCog') -> None:
        super().__init__(title='Transferir Membros -> Favela 1/2')
        self.cog = cog

        self.cocaina = discord.ui.TextInput(label='Cocaína', placeholder='0', required=False, max_length=10, default='0')
        self.metanfetamina = discord.ui.TextInput(label='Metanfetamina', placeholder='0', required=False, max_length=10, default='0')
        self.comum = discord.ui.TextInput(label='Comum', placeholder='0', required=False, max_length=10, default='0')
        self.incomum = discord.ui.TextInput(label='Incomum', placeholder='0', required=False, max_length=10, default='0')

        self.add_item(self.cocaina)
        self.add_item(self.metanfetamina)
        self.add_item(self.comum)
        self.add_item(self.incomum)

    async def on_submit(self, interaction: discord.Interaction) -> None:
        try:
            payload = {
                'autor': interaction.user.display_name,
                'autor_discord_id': str(interaction.user.id),
                'cocaina': parse_int_input(str(self.cocaina)),
                'metanfetamina': parse_int_input(str(self.metanfetamina)),
                'membros_comum': parse_int_input(str(self.comum)),
                'membros_incomum': parse_int_input(str(self.incomum)),
            }
            self.cog.store_pending_members_payload(interaction.user.id, payload)
            await interaction.response.send_message(
                'Parte 1 da transferência dos membros para a favela salva. Clique em Continuar Membros para informar Raro, Mítica e Lendária.',
                view=MembersDepositStepTwoLauncherView(self.cog, interaction.user.id),
                ephemeral=True,
            )
        except ValueError as exc:
            await interaction.response.send_message(f'Entrada inválida: {exc}', ephemeral=True)


