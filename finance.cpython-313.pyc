    def member_withdrawal_cannabis_label(self, quantities: dict[str, Any]) -> str:
        labels = [
            ('Comum', 'membros_comum'),
            ('Incomum', 'membros_incomum'),
            ('Raro', 'membros_raro'),
            ('Mítica', 'membros_mitica'),
            ('Lendária', 'membros_lendaria'),
        ]
        parts = [f'{label}: {int(quantities.get(field, 0) or 0)}x' for label, field in labels if int(quantities.get(field, 0) or 0) > 0]
        if parts:
            return '\n'.join(parts)
        return 'Qtd: 0x'

    def member_withdrawal_total_cannabis(self, quantities: dict[str, Any]) -> int:
        return sum(
            int(quantities.get(field, 0) or 0)
            for field in ('membros_comum', 'membros_incomum', 'membros_raro', 'membros_mitica', 'membros_lendaria')
        )

    async def finalize_pending_member_withdrawal(self, interaction: discord.Interaction, cannabis_rarity: str) -> None:
        pending = self.pop_pending_member_withdrawal_payload(interaction.user.id)
        if pending is None:
            await interaction.response.send_message('A solicitação expirou. Abra o registro novamente.', ephemeral=True)
            return

        self.discard_member_withdrawal_prompt(interaction.user.id, interaction.channel_id)

        field_map = {
            'comum': 'membros_comum',
            'incomum': 'membros_incomum',
            'raro': 'membros_raro',
            'mitica': 'membros_mitica',
            'lendaria': 'membros_lendaria',
        }
        target_field = field_map.get(cannabis_rarity.strip().lower())
        if target_field is None:
            self.store_pending_member_withdrawal_payload(interaction.user.id, pending)
            await interaction.response.send_message('Tipo de maconha inválido.', ephemeral=True)
            return

        try:
            payload = dict(pending)
            maconha_qty = int(payload.pop('maconha', 0) or 0)
            payload[target_field] = maconha_qty
            await interaction.response.edit_message(content='Registrando retirada...', view=None)
            await self.handle_member_withdrawal(interaction, payload)
        except FinanceApiError as exc:
            self.store_pending_member_withdrawal_payload(interaction.user.id, pending)
            await self.send_ephemeral_message(
                interaction,
                content=self.stock_action_error_message('registrar retirada', exc),
            )

