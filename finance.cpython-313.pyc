    def stock_target_balance_text(self, target: str, balance: dict[str, Any]) -> str:
        if target == 'members':
            common_total = int(balance.get('maconha', 0) or 0) + int(balance.get('membros_comum', 0) or 0)
            return (
                f"COC {balance.get('cocaina', 0)} | MT {balance.get('metanfetamina', 0)} | "
                f"C {common_total} | I {balance.get('membros_incomum', 0)} | "
                f"R {balance.get('membros_raro', 0)} | MI {balance.get('membros_mitica', 0)} | L {balance.get('membros_lendaria', 0)}"
            )
        if target == 'favela':
            return (
                f"COC {balance.get('favela_cocaina', 0)} | MT {balance.get('favela_metanfetamina', 0)} | "
                f"C {balance.get('comum', 0)} | I {balance.get('incomum', 0)} | "
                f"R {balance.get('raro', 0)} | M {balance.get('mitica', 0)} | L {balance.get('lendaria', 0)}"
            )
        if target == 'bangalo':
            return (
                f"MA {balance.get('bangalo_maconha', 0)} | COC {balance.get('bangalo_cocaina', 0)} | MT {balance.get('bangalo_metanfetamina', 0)} | "
                f"C {balance.get('bangalo_comum', 0)} | I {balance.get('bangalo_incomum', 0)} | "
                f"R {balance.get('bangalo_raro', 0)} | MI {balance.get('bangalo_mitica', 0)} | L {balance.get('bangalo_lendaria', 0)}"
            )
        if target == 'bangalo2':
            return (
                f"MA {balance.get('bangalo2_maconha', 0)} | COC {balance.get('bangalo2_cocaina', 0)} | MT {balance.get('bangalo2_metanfetamina', 0)} | "
                f"C {balance.get('bangalo2_comum', 0)} | I {balance.get('bangalo2_incomum', 0)} | "
                f"R {balance.get('bangalo2_raro', 0)} | MI {balance.get('bangalo2_mitica', 0)} | L {balance.get('bangalo2_lendaria', 0)}"
            )
        if target == 'mansoes':
            return (
                f"COC {balance.get('mansoes_cocaina', 0)} | MT {balance.get('mansoes_metanfetamina', 0)} | "
                f"C {balance.get('mansoes_comum', 0)} | I {balance.get('mansoes_incomum', 0)} | "
                f"R {balance.get('mansoes_raro', 0)} | M {balance.get('mansoes_mitica', 0)} | L {balance.get('mansoes_lendaria', 0)}"
            )
        return f"M {balance.get('maconha', 0)} | C {balance.get('cocaina', 0)} | MT {balance.get('metanfetamina', 0)}"

