class UnifiedTransferModal(discord.ui.Modal):
    def __init__(self, cog: 'StockCog', target: str) -> None:
        super().__init__(title=cog.unified_transfer_modal_title(target))
        self.cog = cog
        self.target = target

        self.maconha = discord.ui.TextInput(label='Maconha', placeholder='0', required=False, max_length=10, default='0')
        self.cocaina = discord.ui.TextInput(label='Cocaína', placeholder='0', required=False, max_length=10, default='0')
        self.metanfetamina = discord.ui.TextInput(label='Metanfetamina', placeholder='0', required=False, max_length=10, default='0')
        self.observacao = discord.ui.TextInput(
            label='Observação',
            placeholder=cog.unified_transfer_placeholder(target),
            required=False,
            max_length=200,
            style=discord.TextStyle.long,
        )

        self.add_item(self.maconha)
        self.add_item(self.cocaina)
        self.add_item(self.metanfetamina)
        self.add_item(self.observacao)

    async def on_submit(self, interaction: discord.Interaction) -> None:
        try:
            request = {
                'source_scope': self.target,
                'maconha': parse_int_input(str(self.maconha)),
                'cocaina': parse_int_input(str(self.cocaina)),
                'metanfetamina': parse_int_input(str(self.metanfetamina)),
                'observacao': str(self.observacao).strip(),
            }

            if (request['maconha'] + request['cocaina'] + request['metanfetamina']) <= 0:
                raise ValueError('Informe pelo menos uma quantidade maior que zero.')

            self.cog.store_pending_transfer_request(interaction.user.id, request)
            await interaction.response.send_message(
                'Selecione o baú de destino da transferência.',
                view=TransferDestinationView(self.cog, interaction.user.id, self.target),
                ephemeral=True,
            )
        except ValueError as exc:
            await interaction.response.send_message(f'Entrada inválida: {exc}', ephemeral=True)
        except FinanceApiError as exc:
            if interaction.response.is_done():
                await interaction.followup.send(f'Falha ao registrar transferência: {exc}', ephemeral=True)
            else:
                await interaction.response.send_message(f'Falha ao registrar transferência: {exc}', ephemeral=True)


