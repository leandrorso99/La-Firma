    def stock_item_lines(self, prefix: str, quantities: dict[str, Any], include_zero: bool = False) -> list[str]:
        labels = [
            ('🌿', 'Maconha', 'maconha'),
            ('💨', 'Cocaína', 'cocaina'),
            ('🧊', 'Metanf.', 'metanfetamina'),
        ]
        lines: list[str] = []
        for emoji, label, field in labels:
            quantity = int(quantities.get(f'{prefix}{field}', 0) or 0)
            if quantity <= 0 and not include_zero:
                continue
            lines.append(f'{emoji} {label}: {quantity}')
        return lines

    def rarity_stock_lines(self, quantities: dict[str, Any], prefix: str = '', include_zero: bool = False) -> list[str]:
        labels = [
            ('🍃', 'Comum', f'{prefix}comum'),
            ('🟢', 'Incomum', f'{prefix}incomum'),
            ('🔵', 'Raro', f'{prefix}raro'),
            ('🔴', 'Mítica', f'{prefix}mitica'),
            ('🟡', 'Lendária', f'{prefix}lendaria'),
        ]
        lines: list[str] = []
        for emoji, label, field in labels:
            quantity = int(quantities.get(field, 0) or 0)
            if quantity <= 0 and not include_zero:
                continue
            lines.append(f'{emoji} {label}: {quantity}')
        return lines

    def format_deposit_lines(self, rows: list[dict[str, Any]]) -> list[str]:
        lines: list[str] = []
        for row in rows:
            author = str(row.get('autor', 'Gerência')).strip() or 'Gerência'
            date = str(row.get('data', ''))
            for label, field in [
                ('Maconha', 'maconha'),
                ('Cocaína', 'cocaina'),
                ('Metanfetamina', 'metanfetamina'),
                ('Membros Comum', 'membros_comum'),
                ('Membros Incomum', 'membros_incomum'),
                ('Membros Raro', 'membros_raro'),
                ('Membros Mítica', 'membros_mitica'),
                ('Membros Lendária', 'membros_lendaria'),
                ('Favela Cocaína', 'favela_cocaina'),
                ('Favela Metanfetamina', 'favela_metanfetamina'),
                ('Bangalô Maconha', 'bangalo_maconha'),
                ('Bangalô Cocaína', 'bangalo_cocaina'),
                ('Bangalô Metanfetamina', 'bangalo_metanfetamina'),
                ('Bangalô Comum', 'bangalo_comum'),
                ('Bangalô Incomum', 'bangalo_incomum'),
                ('Bangalô Raro', 'bangalo_raro'),
                ('Bangalô Mítica', 'bangalo_mitica'),
                ('Bangalô Lendária', 'bangalo_lendaria'),
                ('Bangalô 2 Maconha', 'bangalo2_maconha'),
                ('Bangalô 2 Cocaína', 'bangalo2_cocaina'),
                ('Bangalô 2 Metanfetamina', 'bangalo2_metanfetamina'),
                ('Bangalô 2 Comum', 'bangalo2_comum'),
                ('Bangalô 2 Incomum', 'bangalo2_incomum'),
                ('Bangalô 2 Raro', 'bangalo2_raro'),
                ('Bangalô 2 Mítica', 'bangalo2_mitica'),
                ('Bangalô 2 Lendária', 'bangalo2_lendaria'),
                ('Mansões Cocaína', 'mansoes_cocaina'),
                ('Mansões Metanfetamina', 'mansoes_metanfetamina'),
            ]:
                quantity = int(row.get(field, 0) or 0)
                if quantity > 0:
                    lines.append(f'{author} guardou {quantity}x {label} em {date}')
        return lines or ['Nenhum depósito registrado nos últimos 7 dias.']

    def format_transaction_lines(self, rows: list[dict[str, Any]]) -> list[str]:
        lines: list[str] = []
        for row in rows:
            author = str(row.get('autor', 'Sem autor')).strip() or 'Sem autor'
            tx_type = str(row.get('tipo', '')).strip().lower()
            amount = float(row.get('valor', 0) or 0)
            reason = str(row.get('motivo', '')).strip() or 'Sem motivo'
            date = str(row.get('data', ''))
            if tx_type == 'deposito':
                emoji = '🟢'
                signal = '+'
            else:
                emoji = '🔴'
                signal = '-'
            lines.append(f'{emoji} {author}: {signal}{money_text(amount)} ({reason}) em {date}')
        return lines or ['Nenhuma transação registrada nos últimos 7 dias.']

    def format_withdrawal_lines(self, rows: list[dict[str, Any]]) -> list[str]:
        lines: list[str] = []
        for row in rows:
            author = str(row.get('autor', 'Membro')).strip() or 'Membro'
            date = str(row.get('data', ''))
            if bool(row.get('is_sample', False)):
                sample_label = str(row.get('sample_label', '')).strip() or f'{int(row.get("quantidade_total", 0) or 0)} item(ns)'
                lines.append(f'🎁 {author} registrou amostra: {sample_label} em {date}')
                continue
            parts: list[str] = []
            for label, field in [('Comum', 'comum'), ('Cocaína', 'cocaina'), ('Metanfetamina', 'metanfetamina')]:
                quantity = int(row.get(field, 0) or 0)
                if quantity > 0:
                    parts.append(f'{quantity}x {label}')
            if not parts:
                continue
            total_value_fmt = str(row.get('total_value_fmt', 'R$ 0,00'))
            lines.append(f'🛒 {author} retirou {" | ".join(parts)} (Pagar: {total_value_fmt}) em {date}')
        return lines or ['Nenhuma retirada registrada nos últimos 7 dias.']

    def format_transfer_lines(self, rows: list[dict[str, Any]]) -> list[str]:
        lines: list[str] = []
        for row in rows:
            author = str(row.get('autor', 'Sem autor')).strip() or 'Sem autor'
            source_scope = str(row.get('origem', '')).strip() or 'Origem não informada'
            destination_scope = str(row.get('destino', '')).strip() or 'Destino não informado'
            items = str(row.get('itens', '')).strip() or 'Sem itens'
            date = str(row.get('data', ''))
            lines.append(f'🔁 {author} transferiu {items} de {source_scope} para {destination_scope} em {date}')
        return lines or ['Nenhuma transferência registrada nos últimos 7 dias.']

    def paginate_weekly_history(self, sections: list[tuple[str, list[str]]], max_chars: int = 3500) -> list[str]:
        pages: list[str] = []
        current_lines: list[str] = []

        def flush_page() -> None:
            if current_lines:
                pages.append('\n'.join(current_lines).strip())
                current_lines.clear()

        for title, lines in sections:
            block_lines = [title] + lines + ['']
            if len('\n'.join(block_lines)) > max_chars:
                chunk: list[str] = [title]
                for line in lines:
                    candidate = '\n'.join(chunk + [line])
                    if len(candidate) > max_chars and len(chunk) > 1:
                        if current_lines:
                            flush_page()
                        pages.append('\n'.join(chunk).strip())
                        chunk = [title, line]
                    else:
                        chunk.append(line)
                if len(chunk) > 1:
                    if current_lines:
                        flush_page()
                    pages.append('\n'.join(chunk).strip())
                continue

            candidate_page = '\n'.join(current_lines + block_lines).strip()
            if current_lines and len(candidate_page) > max_chars:
                flush_page()
            current_lines.extend(block_lines)

        flush_page()
        return pages or ['Sem dados para exibir.']

    def resolve_ticket_category(self, guild: discord.Guild, fallback_channel: discord.abc.GuildChannel | None) -> discord.CategoryChannel | None:
        category_id = int(getattr(config, 'STOCK_TICKET_CATEGORY_ID', 0) or 0)
        if category_id > 0:
            channel = guild.get_channel(category_id)
            if isinstance(channel, discord.CategoryChannel):
                return channel

        for category in guild.categories:
            if normalize_category_name(category.name) == 'ticket':
                return category

        if isinstance(fallback_channel, discord.TextChannel) and isinstance(fallback_channel.category, discord.CategoryChannel):
            return fallback_channel.category

        return None

    def can_manage_stock(self, interaction: discord.Interaction) -> bool:
        user = interaction.user
        if not isinstance(user, discord.Member):
            return False
        return user.guild_permissions.administrator or user.guild_permissions.manage_guild or has_any_role(user, self.manager_role_ids())

    def can_close_ticket(self, interaction: discord.Interaction) -> bool:
        user = interaction.user
        if not isinstance(user, discord.Member):
            return False
        return user.guild_permissions.administrator or user.guild_permissions.manage_channels or has_any_role(user, self.close_role_ids()) or has_any_role(user, self.manager_role_ids())

    def panel_embed(self) -> discord.Embed:
        embed = discord.Embed(
            title='📦 RETIRADA E ESTOQUE - LA FIRMA',
            description=(
                '**Registrar (Membro)** cria seu ticket privado para lançar retirada do baú e amostras.\n'
                '**Transferência de Estoque** permite escolher o baú de origem e o baú de destino antes de registrar a movimentação.\n'
                '**Histórico Semanal** soma banco, vendas e retiradas em tempo real, incluindo o Bangalô.'
            ),
            color=0xF59F00,
        )
        embed.set_footer(text='Retirada salva no site e auditada no Discord')
        return embed

    def ticket_embed(self, member: discord.abc.User) -> discord.Embed:
        embed = discord.Embed(
            title='Ticket de Retirada Aberto',
            description=(
                f'{member.mention}, use **Registrar Retirada** para lançamentos cobrados e **Registrar Amostra** para saídas grátis.\n'
                'Quando terminar, a liderança pode usar **Fechar Ticket**.'
            ),
            color=0x0D6EFD,
        )
        embed.set_footer(text='Tudo que for lançado aqui será salvo no site')
        return embed

    def sample_registered_embed(
        self,
        member: discord.Member,
        quantity: int,
        item_count: int,
        items_label: str,
        observation: str = '',
    ) -> discord.Embed:
        embed = discord.Embed(
            title='🎁 Amostra Registrada',
            description=f'O membro {member.mention} registrou uma nova amostra.',
            color=0xF05D5E,
        )
        embed.add_field(name='Itens', value=items_label or 'Sem itens', inline=False)
        embed.add_field(name='Quantidade Total', value=str(quantity), inline=True)
        embed.add_field(name='Linhas', value=str(item_count), inline=True)
        if observation.strip():
            embed.add_field(name='Observação', value=observation.strip(), inline=False)
        embed.add_field(name='Cobrança', value='Amostra grátis', inline=False)
        embed.set_footer(text='Essa saída baixa o estoque, mas não gera valor no financeiro.')
        return embed

    def withdrawal_registered_embed(
        self,
        member: discord.Member,
        quantities: dict[str, Any],
        prices: dict[str, Any],
        total_value_fmt: str,
        pix_key: str,
        is_sample: bool,
    ) -> discord.Embed:
        embed = discord.Embed(
            title='🎁 Amostra Registrada' if is_sample else '📝 Retirada Registrada',
            description=f'O membro {member.mention} registrou uma nova {"amostra" if is_sample else "retirada"}.',
            color=0xF05D5E,
        )

        labels = [
            ('📦 Cocaína', 'cocaina', 'cocaina'),
            ('📦 Metanfetamina', 'metanfetamina', 'metanfetamina'),
        ]
        unit_prices = []

        cannabis_quantity = self.member_withdrawal_total_cannabis(quantities)
        cannabis_unit_price = float(prices.get('maconha', 0) or 0)
        unit_prices.append(cannabis_unit_price)
        if is_sample:
            cannabis_value_text = f'{self.member_withdrawal_cannabis_label(quantities)}\nCobrança: Não'
        else:
            cannabis_value_text = f'{self.member_withdrawal_cannabis_label(quantities)}\nValor: {money_text(cannabis_quantity * cannabis_unit_price)}'
        embed.add_field(
            name='📦 Maconha',
            value=cannabis_value_text,
            inline=True,
        )

        for label, field, price_field in labels:
            quantity = int(quantities.get(field, 0) or 0)
            unit_price = float(prices.get(price_field, 0) or 0)
            unit_prices.append(unit_price)
            if is_sample:
                value_text = f'Qtd: {quantity}x\nCobrança: Não'
            else:
                value_text = f'Qtd: {quantity}x\nValor: {money_text(quantity * unit_price)}'
            embed.add_field(
                name=label,
                value=value_text,
                inline=True,
            )

        if is_sample:
            embed.add_field(name='Cobrança', value='Amostra grátis', inline=False)
            embed.set_footer(text='Essa saída baixa o estoque, mas não gera valor no financeiro.')
            return embed

        embed.add_field(name='Total a Pagar', value=total_value_fmt, inline=False)
        embed.add_field(name='PIX', value=pix_key or 'Não informado', inline=False)

        non_zero_prices = [price for price in unit_prices if price > 0]
        if non_zero_prices and len(set(non_zero_prices)) == 1:
            embed.set_footer(text=f'A taxa é de {money_text(non_zero_prices[0])} por unidade.')
        else:
            embed.set_footer(text='Os valores por item foram calculados conforme a tabela atual.')

        return embed

    async def send_panel(self, destination: discord.abc.Messageable) -> None:
        await destination.send(embed=self.panel_embed(), view=StockPanelView(self))

    def bot_member(self, guild: discord.Guild) -> discord.Member | None:
        if self.bot.user is None:
            return None
        return guild.get_member(self.bot.user.id)

    async def publish_panel(self, interaction: discord.Interaction, configured_channel_id: int) -> str:
        fallback_channel = interaction.channel
        if configured_channel_id <= 0:
            if fallback_channel is None:
                raise FinanceApiError('Canal atual indisponível para enviar o painel.')
            await self.send_panel(fallback_channel)
            return 'current'

        try:
            channel = self.bot.get_channel(configured_channel_id) or await self.bot.fetch_channel(configured_channel_id)
            await self.send_panel(channel)
            return 'configured'
        except (discord.Forbidden, discord.NotFound, discord.HTTPException):
            if fallback_channel is None:
                raise FinanceApiError(
                    'O bot não conseguiu acessar o canal configurado do painel. Verifique o ID e as permissões de Ver canal e Enviar mensagens.'
                )

            await self.send_panel(fallback_channel)
            return 'fallback'

    async def audit_destination(self, interaction: discord.Interaction) -> discord.abc.Messageable | None:
        channel_id = int(getattr(config, 'STOCK_LOG_CHANNEL_ID', 0) or 0)
        if channel_id > 0:
            try:
                return self.bot.get_channel(channel_id) or await self.bot.fetch_channel(channel_id)
            except (discord.Forbidden, discord.NotFound, discord.HTTPException):
                LOGGER.warning('Nao foi possivel acessar STOCK_LOG_CHANNEL_ID=%s', channel_id)
                return interaction.channel
        return interaction.channel

    async def send_audit_log(self, interaction: discord.Interaction, title: str, color: int, fields: list[tuple[str, str, bool]]) -> None:
        destination = await self.audit_destination(interaction)
        if destination is None:
            return
        embed = discord.Embed(title=title, color=color)
        embed.set_author(name=interaction.user.display_name, icon_url=interaction.user.display_avatar.url)
        for name, value, inline in fields:
            embed.add_field(name=name, value=value, inline=inline)
        embed.set_footer(text='Persistido no site e auditado no Discord')
        await destination.send(embed=embed, delete_after=self.audit_log_delete_after())

    async def resolve_existing_ticket_channel(self, guild: discord.Guild, channel_id: str) -> tuple[discord.TextChannel | None, bool]:
        try:
            parsed_channel_id = int(channel_id)
        except (TypeError, ValueError):
            return None, True

        cached_channel = guild.get_channel(parsed_channel_id)
        if isinstance(cached_channel, discord.TextChannel):
            return cached_channel, False

        try:
            fetched_channel = await self.bot.fetch_channel(parsed_channel_id)
        except discord.NotFound:
            return None, True
        except (discord.Forbidden, discord.HTTPException):
            return None, False

        if isinstance(fetched_channel, discord.TextChannel) and fetched_channel.guild.id == guild.id:
            return fetched_channel, False

        return None, False

    async def close_orphaned_ticket(self, channel_id: str) -> None:
        bot_user = self.bot.user
        closed_by_name = str(getattr(bot_user, 'display_name', '') or getattr(bot_user, 'name', '') or 'Bot Finance')
        closed_by_discord_id = str(bot_user.id) if bot_user is not None else ''
        await self.api.post('stock_ticket_close.php', {
            'channel_discord_id': channel_id,
            'closed_by_discord_id': closed_by_discord_id,
            'closed_by_name': closed_by_name,
        })

    async def find_open_ticket_for_member(self, member_discord_id: str) -> dict[str, Any] | None:
        member_discord_id = str(member_discord_id or '').strip()
        if member_discord_id == '':
            return None

        data = await self.api.post('stock_ticket_find_open.php', {
            'member_discord_id': member_discord_id,
        })
        ticket = data.get('ticket')
        if not isinstance(ticket, dict):
            return None
        return ticket

    async def find_ticket_for_channel(self, channel_discord_id: str) -> dict[str, Any] | None:
        channel_discord_id = str(channel_discord_id or '').strip()
        if channel_discord_id == '':
            return None

        data = await self.api.post('stock_ticket_find_by_channel.php', {
            'channel_discord_id': channel_discord_id,
        })
        ticket = data.get('ticket')
        if not isinstance(ticket, dict):
            return None
        return ticket

    async def resolve_channel_delete_actor(self, guild: discord.Guild, channel_id: int) -> tuple[str | None, str]:
        me = guild.me
        if me is None or not me.guild_permissions.view_audit_log:
            return None, 'Canal removido manualmente no Discord'

        try:
            async for entry in guild.audit_logs(action=discord.AuditLogAction.channel_delete, limit=8):
                target = entry.target
                if not isinstance(target, discord.abc.GuildChannel):
                    continue
                if int(getattr(target, 'id', 0) or 0) != channel_id:
                    continue

                created_at = entry.created_at
                if created_at is not None:
                    now_utc = dt.datetime.now(dt.timezone.utc)
                    if (now_utc - created_at).total_seconds() > 120:
                        continue

                user = entry.user
                if user is None:
                    return None, 'Canal removido manualmente no Discord'

                actor_id = str(int(user.id)) if getattr(user, 'id', None) is not None else None
                actor_name = getattr(user, 'display_name', None) or getattr(user, 'name', None) or 'Canal removido manualmente no Discord'
                return actor_id, str(actor_name)
        except discord.Forbidden:
            return None, 'Canal removido manualmente no Discord'
        except discord.HTTPException:
            return None, 'Canal removido manualmente no Discord'

        return None, 'Canal removido manualmente no Discord'

    @commands.Cog.listener()
    async def on_guild_channel_delete(self, channel: discord.abc.GuildChannel) -> None:
        if not isinstance(channel, discord.TextChannel):
            return

        try:
            ticket = await self.find_ticket_for_channel(str(channel.id))
            if not isinstance(ticket, dict):
                return
            if str(ticket.get('status', '')).strip().lower() != 'open':
                return

            actor_discord_id, actor_name = await self.resolve_channel_delete_actor(channel.guild, channel.id)
            await self.api.post('stock_ticket_close.php', {
                'channel_discord_id': str(channel.id),
                'closed_by_discord_id': actor_discord_id or '',
                'closed_by_name': actor_name,
            })
            LOGGER.info('Ticket fechado automaticamente após deleção manual do canal: channel_id=%s actor=%s', channel.id, actor_name)
        except FinanceApiError as exc:
            LOGGER.warning('Falha ao registrar fechamento de ticket após deleção manual do canal %s: %s', channel.id, exc)
        except Exception:
            LOGGER.exception('Erro inesperado ao processar deleção manual do canal %s', channel.id)

    async def handle_member_ticket_open(self, interaction: discord.Interaction) -> None:
        if interaction.guild is None or not isinstance(interaction.user, discord.Member):
            await self.send_ephemeral_message(interaction, content='Esse botão só funciona dentro do servidor.')
            return

        deferred = await self.defer_ephemeral_safely(interaction, thinking=True)
        if not deferred:
            return

        guild = interaction.guild
        bot_member = self.bot_member(guild)
        if bot_member is None:
            await self.send_ephemeral_message(interaction, content='Não consegui localizar o bot neste servidor para criar o ticket.')
            return

        if not bot_member.guild_permissions.manage_channels:
            await self.send_ephemeral_message(interaction, content='O bot não tem a permissão Gerenciar Canais. Libere essa permissão no cargo do bot para criar tickets.')
            return

        category = self.resolve_ticket_category(guild, interaction.channel)

        if isinstance(category, discord.CategoryChannel):
            category_perms = category.permissions_for(bot_member)
            if not category_perms.view_channel or not category_perms.manage_channels:
                await self.send_ephemeral_message(interaction, content='O bot não tem acesso suficiente à categoria configurada para criar tickets. Verifique Ver Canal e Gerenciar Canais na categoria.')
                return

        existing_ticket = await self.find_open_ticket_for_member(str(interaction.user.id))
        if existing_ticket is not None:
            existing_channel_id = str(existing_ticket.get('discord_channel_id', '') or '').strip()
            existing_channel, channel_missing = await self.resolve_existing_ticket_channel(guild, existing_channel_id)

            if channel_missing and existing_channel_id != '':
                LOGGER.warning(
                    'Ticket órfão detectado para o membro %s no canal %s; fechando registro antigo antes de abrir um novo.',
                    interaction.user.id,
                    existing_channel_id,
                )
                try:
                    await self.close_orphaned_ticket(existing_channel_id)
                except FinanceApiError as exc:
                    LOGGER.warning('Falha ao fechar ticket órfão do membro %s: %s', interaction.user.id, exc)
                    await self.send_ephemeral_message(
                        interaction,
                        content='Existe um ticket antigo inconsistente e não foi possível limpá-lo agora. Chame um administrador para encerrar no painel.',
                    )
                    return
            else:
                mention = existing_channel.mention if existing_channel is not None else f'<#{existing_channel_id}>'
                await self.send_ephemeral_message(interaction, content=f'Você já possui um ticket aberto em {mention}.')
                return

        channel_name = f'retirada-{sanitize_channel_name(interaction.user.display_name)}'
        overwrites: dict[discord.abc.Snowflake, discord.PermissionOverwrite] = {
            guild.default_role: discord.PermissionOverwrite(view_channel=False),
            interaction.user: discord.PermissionOverwrite(view_channel=True, send_messages=True, read_message_history=True, attach_files=True),
        }

        for role_id in self.support_role_ids():
            role = guild.get_role(role_id)
            if role is not None:
                overwrites[role] = discord.PermissionOverwrite(view_channel=True, send_messages=True, read_message_history=True)

        try:
            channel = await guild.create_text_channel(
                name=channel_name,
                overwrites=overwrites,
                category=category,
                topic=f'Ticket de retirada de {interaction.user.display_name} ({interaction.user.id})',
                reason=f'Ticket de retirada criado por {interaction.user}',
            )
        except discord.Forbidden as exc:
            raise FinanceApiError(
                'O bot não conseguiu criar o canal do ticket. Verifique as permissões Gerenciar Canais e Ver Canal na categoria dos tickets.'
            ) from exc
        except discord.HTTPException as exc:
            raise FinanceApiError(f'Erro ao criar o canal do ticket: {exc}') from exc

        try:
            payload = {
                'member_discord_id': str(interaction.user.id),
                'member_name': interaction.user.display_name,
                'channel_discord_id': str(channel.id),
                'channel_name': channel.name,
            }
            result = await self.api.post('stock_ticket_open.php', payload)
        except FinanceApiError as exc:
            await channel.send(
                '⚠️ Não foi possível vincular este ticket no site agora. O canal foi mantido para revisão manual da gerência/ADM.'
            )
            raise FinanceApiError(f'Falha ao registrar ticket no site: {exc}') from exc

        ticket = result.get('ticket', {}) if isinstance(result.get('ticket'), dict) else {}
        existing_channel_id = str(ticket.get('discord_channel_id', ''))
        if result.get('status') == 'existing' and existing_channel_id and existing_channel_id != str(channel.id):
            existing_channel, channel_missing = await self.resolve_existing_ticket_channel(guild, existing_channel_id)
            if channel_missing:
                LOGGER.warning(
                    'Ticket órfão detectado para o membro %s no canal %s; fechando registro antigo antes de reabrir.',
                    interaction.user.id,
                    existing_channel_id,
                )
                try:
                    await self.close_orphaned_ticket(existing_channel_id)
                    result = await self.api.post('stock_ticket_open.php', payload)
                except FinanceApiError as exc:
                    await channel.send(
                        '⚠️ Ticket antigo inconsistente encontrado e não foi possível limpá-lo automaticamente. O canal foi mantido para revisão manual.'
                    )
                    raise FinanceApiError(f'Falha ao limpar ticket órfão: {exc}') from exc

                ticket = result.get('ticket', {}) if isinstance(result.get('ticket'), dict) else {}
                existing_channel_id = str(ticket.get('discord_channel_id', ''))
                if result.get('status') != 'existing' or existing_channel_id == str(channel.id):
                    await channel.send(content=interaction.user.mention, embed=self.ticket_embed(interaction.user), view=StockTicketView(self))
                    await self.send_ephemeral_message(interaction, content=f'Ticket criado em {channel.mention}.')
                    return

                existing_channel, _ = await self.resolve_existing_ticket_channel(guild, existing_channel_id)

            mention = existing_channel.mention if existing_channel is not None else f'<#{existing_channel_id}>'
            await channel.send(
                f'⚠️ Este ticket foi detectado como duplicado. Utilize o ticket original em {mention}. Este canal foi mantido para conferência manual.'
            )
            await self.send_ephemeral_message(interaction, content=f'Você já possui um ticket aberto em {mention}.')
            return

        await channel.send(content=interaction.user.mention, embed=self.ticket_embed(interaction.user), view=StockTicketView(self))
        await self.send_ephemeral_message(interaction, content=f'Ticket criado em {channel.mention}.')

    async def handle_pending_sample_rarity(self, interaction: discord.Interaction, rarity: str) -> None:
        request = self.pending_sample_requests.get(interaction.user.id)
        if request is None:
            await interaction.response.send_message('A solicitação expirou. Abra o fluxo novamente.', ephemeral=True)
            return

        draft_item = request.get('draft_item', {}) if isinstance(request.get('draft_item'), dict) else {}
        draft_item['rarity'] = rarity
        request['draft_item'] = draft_item
        self.store_pending_sample_request(interaction.user.id, request)
        await interaction.response.edit_message(
            content='Selecione o baú de origem do item.',
            view=SampleSourceSelectionView(self, interaction.user.id),
        )

    async def handle_pending_sample_source(self, interaction: discord.Interaction, source_scope: str) -> None:
        request = self.pending_sample_requests.get(interaction.user.id)
        if request is None:
            await interaction.response.send_message('A solicitação expirou. Abra o fluxo novamente.', ephemeral=True)
            return

        draft_item = request.get('draft_item', {}) if isinstance(request.get('draft_item'), dict) else {}
        if not draft_item:
            await interaction.response.send_message('O item da amostra expirou. Reabra o fluxo.', ephemeral=True)
            return

        draft_item['source_scope'] = source_scope
        if str(draft_item.get('drug_type', '')) == 'metanfetamina':
            draft_item['rarity'] = None
        elif not draft_item.get('rarity'):
            draft_item['rarity'] = 'comum'

        items = request.get('items', []) if isinstance(request.get('items'), list) else []
        items.append(draft_item)
        request['items'] = items
        request.pop('draft_item', None)
        self.store_pending_sample_request(interaction.user.id, request)

        await interaction.response.edit_message(
            content=self.sample_builder_content(request, prefix='Item adicionado à amostra.'),
            view=SampleBuilderView(self, interaction.user.id),
        )

    async def handle_manager_deposit(self, interaction: discord.Interaction, payload: dict[str, Any], target: str = 'members') -> None:
        payload = dict(payload)
        payload['source'] = 'discord'
        if payload.get('transfer_stock'):
            payload['transfer_stock'] = True
            payload['transfer_source_scope'] = payload.get('transfer_source_scope', target)
            payload['transfer_destination_scope'] = payload.get('transfer_destination_scope', 'favela')

        if not interaction.response.is_done():
            deferred = await self.defer_ephemeral_safely(interaction)
            if not deferred:
                return

        result = await self.api.post('stock_manager_deposit.php', payload)
        quantities = result.get('quantities', {}) if isinstance(result.get('quantities'), dict) else {}
        balance = result.get('balance', {}) if isinstance(result.get('balance'), dict) else {}
        total_value_fmt = str(result.get('total_value_fmt', 'R$ 0,00'))
        target_name = self.stock_target_name(target)

        if result.get('transferred'):
            source_scope = str(result.get('source_scope', target))
            source_label = str(result.get('source_scope_label', self.transfer_target_name(source_scope)))
            destination_scope = str(result.get('destination_scope', 'favela'))
            destination_label = str(result.get('destination_scope_label', self.stock_scope_name(destination_scope)))
            warnings = result.get('warnings', []) if isinstance(result.get('warnings'), list) else []

            message = f'Transferência registrada de {source_label} para {destination_label}.'

            if warnings:
                message += '\n' + '\n'.join(str(item) for item in warnings if str(item).strip())

            await self.send_ephemeral_message(interaction, content=message)

            audit_fields: list[tuple[str, str, bool]] = [
                ('Origem', source_label, True),
                ('Destino', destination_label, True),
                ('Itens', self.transfer_quantities_text(quantities), False),
                ('Saldo destino', self.stock_target_balance_text(destination_scope, balance), False),
            ]
            if source_scope != destination_scope:
                audit_fields.insert(3, ('Saldo origem', self.stock_target_balance_text(source_scope, balance), False))

            await self.send_audit_log(
                interaction,
                'Transferência de estoque registrada',
                0x198754,
                audit_fields,
            )
            return

        message = f'Entrada registrada no {target_name.lower()}.'
        if target == 'members':
            message += f' Valor de referência: {total_value_fmt}'
        await self.send_ephemeral_message(interaction, content=message)

        await self.send_audit_log(
            interaction,
            f'Entrada registrada em {target_name}',
            0x198754,
            self.stock_target_audit_fields(target, quantities, balance, total_value_fmt),
        )

    async def handle_member_withdrawal(self, interaction: discord.Interaction, payload: dict[str, Any]) -> None:
        result = await self.api.post('stock_member_withdrawal.php', payload)
        stock_entry_id = int(result.get('stock_entry_id', 0) or 0)
        quantities = result.get('quantities', {}) if isinstance(result.get('quantities'), dict) else {}
        prices = result.get('prices', {}) if isinstance(result.get('prices'), dict) else {}
        warnings = result.get('warnings', []) if isinstance(result.get('warnings'), list) else []
        total_value_fmt = str(result.get('total_value_fmt', 'R$ 0,00'))
        pix_key = str(result.get('pix_key', 'lafirma( BlackBelt )')).strip()

        message = f'Retirada registrada. Valor que precisa depositar: {total_value_fmt}'
        if stock_entry_id > 0:
            message += f'\nProtocolo do lançamento: #{stock_entry_id}'
        message += f'\nAPI: {self.api.base_url}'
        if warnings:
            message += '\n' + '\n'.join(str(item) for item in warnings if str(item).strip())
        await self.send_ephemeral_message(interaction, content=message)

        if interaction.channel is not None and isinstance(interaction.user, discord.Member):
            await interaction.channel.send(
                embed=self.withdrawal_registered_embed(
                    interaction.user,
                    quantities,
                    prices,
                    total_value_fmt,
                    pix_key,
                    False,
                ),
            )

        await self.send_audit_log(
            interaction,
            'Retirada de membro registrada',
            0xF59F00,
            [
                ('Maconha', self.member_withdrawal_cannabis_label(quantities).replace('\n', ' | '), False),
                ('Cocaína', str(quantities.get('cocaina', 0)), True),
                ('Metanfetamina', str(quantities.get('metanfetamina', 0)), True),
                ('Cobrança', total_value_fmt, True),
                ('Origem', 'Ticket + Site', True),
            ],
        )

    async def handle_member_sample(self, interaction: discord.Interaction, payload: dict[str, Any]) -> None:
        try:
            result = await self.api.post('stock_member_sample.php', payload)
        except FinanceApiError as exc:
            message = str(exc)
            if 'stock_member_sample.php' in message or 'Resposta não JSON da API (404' in message:
                raise FinanceApiError(
                    'o endpoint de amostra não foi encontrado no site publicado. Publique o arquivo api/stock_member_sample.php junto com includes/drug_stock.php antes de tentar novamente.'
                ) from exc
            raise
        warnings = result.get('warnings', []) if isinstance(result.get('warnings'), list) else []
        items_label = str(result.get('items_label', '')).strip() or str(result.get('drug_label', 'Amostra'))
        quantity = int(result.get('quantity', 0) or 0)
        item_count = int(result.get('item_count', 0) or 0)
        observation = str(result.get('observacao', '')).strip()

        message = f'Amostra registrada: {items_label}'
        if item_count > 1:
            message += f' ({item_count} itens)'
        if observation:
            message += f'\nObservação: {observation}'
        if warnings:
            message += '\n' + '\n'.join(str(item) for item in warnings if str(item).strip())
        await self.send_ephemeral_message(interaction, content=message)

        if interaction.channel is not None and isinstance(interaction.user, discord.Member):
            await interaction.channel.send(
                embed=self.sample_registered_embed(interaction.user, quantity, item_count, items_label, observation),
                delete_after=self.audit_log_delete_after(),
            )

        await self.send_audit_log(
            interaction,
            'Amostra de membro registrada',
            0xF05D5E,
            [
                ('Itens', items_label, False),
                ('Quantidade total', str(quantity), True),
                ('Linhas', str(item_count), True),
                ('Observação', observation or 'Sem observação', False),
                ('Cobrança', 'Amostra grátis', True),
            ],
        )

    async def handle_stock_reset_scope(self, interaction: discord.Interaction, scope: str) -> None:
        result = await self.api.post('stock_reset_scope.php', {
            'autor': interaction.user.display_name,
            'autor_discord_id': str(interaction.user.id),
            'scope': scope,
            'observacao': f'Zeragem via Discord: {self.stock_scope_name(scope)}',
        })
        adjusted_items = result.get('adjusted_items', {}) if isinstance(result.get('adjusted_items'), dict) else {}
        balance = result.get('balance', {}) if isinstance(result.get('balance'), dict) else {}
        scope_name = self.stock_scope_name(scope)

        if result.get('already_zero'):
            message = f'{scope_name} já estava zerado.'
        else:
            message = f'{scope_name} zerado com sucesso. Ajustes: {self.stock_adjusted_items_text(adjusted_items)}'

        await self.send_ephemeral_message(interaction, content=message)

        if result.get('already_zero'):
            return

        await self.send_audit_log(
            interaction,
            f'Estoque zerado em {scope_name}',
            0xDC3545,
            self.stock_scope_audit_fields(scope, adjusted_items, balance),
        )

    async def handle_close_ticket(self, interaction: discord.Interaction) -> None:
        if interaction.guild is None or not isinstance(interaction.user, discord.Member) or not isinstance(interaction.channel, discord.TextChannel):
            await self.send_ephemeral_message(interaction, content='Esse botão só funciona em um ticket do servidor.')
            return

        if not self.can_close_ticket(interaction):
            await self.send_ephemeral_message(interaction, content='Você não tem permissão para fechar este ticket.')
            return

        deferred = await self.defer_ephemeral_safely(interaction)
        if not deferred:
            return

        result = await self.api.post('stock_ticket_close.php', {
            'channel_discord_id': str(interaction.channel.id),
            'closed_by_discord_id': str(interaction.user.id),
            'closed_by_name': interaction.user.display_name,
        })
        ticket = result.get('ticket', {}) if isinstance(result.get('ticket'), dict) else {}
        await self.send_audit_log(
            interaction,
            'Ticket fechado',
            0xDC3545,
            [
                ('Canal', interaction.channel.mention, False),
                ('Membro', str(ticket.get('member_name', 'Não identificado')), False),
            ],
        )

        await self.send_ephemeral_message(interaction, content='Ticket fechado e removido.')

        try:
            await interaction.channel.delete(reason=f'Ticket encerrado por {interaction.user}')
        except discord.Forbidden as exc:
            raise FinanceApiError('O bot não conseguiu excluir o canal do ticket. Verifique a permissão Gerenciar Canais.') from exc
        except discord.HTTPException as exc:
            raise FinanceApiError(f'Erro ao excluir o canal do ticket: {exc}') from exc

    async def handle_weekly_history(self, interaction: discord.Interaction) -> None:
        deferred = await self.defer_ephemeral_safely(interaction)
        if not deferred:
            return
        data = await self.api.get('stock_weekly_history.php')
        financial = data.get('financial', {}) if isinstance(data.get('financial'), dict) else {}
        withdrawals = data.get('withdrawals', {}) if isinstance(data.get('withdrawals'), dict) else {}
        recent = data.get('recent', {}) if isinstance(data.get('recent'), dict) else {}
        stock = data.get('stock', {}) if isinstance(data.get('stock'), dict) else {}
        balance = stock.get('balance', {}) if isinstance(stock.get('balance'), dict) else {}
        period = data.get('period', {}) if isinstance(data.get('period'), dict) else {}

        deposit_rows = recent.get('deposits', []) if isinstance(recent.get('deposits'), list) else []
        transaction_rows = recent.get('transactions', []) if isinstance(recent.get('transactions'), list) else []
        withdrawal_rows = withdrawals.get('rows', []) if isinstance(withdrawals.get('rows'), list) else []
        transfer_rows = recent.get('transfers', []) if isinstance(recent.get('transfers'), list) else []

        sections = [
            (
                '🏦 Banco da Facção',
                [
                    str(financial.get('total_banco_fmt', 'R$ 0,00')),
                    '',
                    '📦 Bangalô Membros',
                    f'💨 Cocaína: {int(balance.get("cocaina", 0) or 0)}',
                    f'🧊 Metanf.: {int(balance.get("metanfetamina", 0) or 0)}',
                    f'🍃 Comum: {int(balance.get("maconha", 0) or 0) + int(balance.get("membros_comum", 0) or 0)}',
                    *self.rarity_stock_lines(balance, prefix='membros_', include_zero=True),
                    '',
                    '🌿 Baú da Favela',
                    *self.stock_item_lines('favela_', balance, include_zero=True),
                    *self.rarity_stock_lines(balance, include_zero=True),
                    '',
                    '🏡 Bangalô Estoque Gerência',
                    *self.stock_item_lines('bangalo_', balance, include_zero=True),
                    *self.rarity_stock_lines(balance, prefix='bangalo_', include_zero=True),
                    '',
                    '🏠 Bangalô 2 Estoque Gerência',
                    *self.stock_item_lines('bangalo2_', balance, include_zero=True),
                    *self.rarity_stock_lines(balance, prefix='bangalo2_', include_zero=True),
                    '',
                    '🏘️ Baú de Mansões',
                    *self.stock_item_lines('mansoes_', balance, include_zero=True),
                    *self.rarity_stock_lines(balance, prefix='mansoes_', include_zero=True),
                ],
            ),
            (
                f'📝 Depósitos ({period.get("label", "Últimos 7 dias")})',
                self.format_deposit_lines(deposit_rows),
            ),
            (
                f'💸 Transações ({period.get("label", "Últimos 7 dias")})',
                self.format_transaction_lines(transaction_rows),
            ),
            (
                f'🛒 Retiradas a Pagar ({period.get("label", "Últimos 7 dias")})',
                self.format_withdrawal_lines(withdrawal_rows),
            ),
            (
                f'🔁 Transferências ({period.get("label", "Últimos 7 dias")})',
                self.format_transfer_lines(transfer_rows),
            ),
        ]

        pages = self.paginate_weekly_history(sections)
        view = WeeklyHistoryView(self, interaction.user.id, pages)
        await self.send_ephemeral_message(interaction, embed=view.current_embed(), view=view)

    @app_commands.command(name='painelretirada', description='Envia o painel de retirada e estoque.')
    async def painel_retirada(self, interaction: discord.Interaction) -> None:
        deferred = await self.defer_ephemeral_safely(interaction)
        if not deferred:
            return
        channel_id = int(getattr(config, 'STOCK_PANEL_CHANNEL_ID', 0) or 0)
        destination = await self.publish_panel(interaction, channel_id)

        if destination == 'configured':
            await self.send_ephemeral_message(interaction, content='Painel de retirada enviado no canal configurado.')
            return

        if destination == 'fallback' and channel_id > 0:
            await self.send_ephemeral_message(interaction, content='O bot não conseguiu acessar o canal configurado em STOCK_PANEL_CHANNEL_ID. Enviei o painel neste canal. Verifique o ID e as permissões do bot.')
            return

        await self.send_ephemeral_message(interaction, content='Painel de retirada enviado neste canal.')


async def setup(bot: commands.Bot) -> None:
    await bot.add_cog(StockCog(bot))