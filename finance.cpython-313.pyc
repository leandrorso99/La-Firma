class StockPanelView(discord.ui.View):
    def __init__(self, cog: 'StockCog') -> None:
        super().__init__(timeout=None)
        self.cog = cog

    async def on_error(self, interaction: discord.Interaction, error: Exception, item: discord.ui.Item[Any]) -> None:
        LOGGER.exception('Erro em StockPanelView no item %s', getattr(item, 'custom_id', None), exc_info=error)
        if is_ignorable_discord_http(error):
            return
        await self.cog.send_ephemeral_message(
            interaction,
            content='Falha ao processar esta interação. Tente novamente em instantes.',
        )

    @discord.ui.button(label='Registrar (Membro)', style=discord.ButtonStyle.primary, emoji='🎫', custom_id='stock:panel:member', row=0)
    async def member_button(self, interaction: discord.Interaction, button: discord.ui.Button) -> None:
        try:
            await self.cog.handle_member_ticket_open(interaction)
        except (FinanceApiError, discord.Forbidden, discord.HTTPException) as exc:
            if isinstance(exc, discord.HTTPException) and getattr(exc, 'code', None) in {40060, 10062}:
                return
            await self.cog.send_ephemeral_message(interaction, content=f'Falha ao abrir ticket: {exc}')
        except Exception as exc:
            LOGGER.exception('Erro inesperado ao abrir ticket pelo painel', exc_info=exc)
            await self.cog.send_ephemeral_message(interaction, content='Erro inesperado ao abrir ticket. Tente novamente em instantes.')

    @discord.ui.button(label='Transferência de Estoque', style=discord.ButtonStyle.success, emoji='🔁', custom_id='stock:panel:manager-transfer', row=0)
    async def manager_transfer_button(self, interaction: discord.Interaction, button: discord.ui.Button) -> None:
        try:
            if not self.cog.can_manage_stock(interaction):
                await self.cog.send_ephemeral_message(interaction, content='Somente a gerência pode registrar transferências entre os baús.')
                return
            await self.cog.send_ephemeral_message(interaction, content='Selecione o baú de origem da transferência.', view=TransferSourceView(self.cog, interaction.user.id))
        except Exception as exc:
            LOGGER.exception('Erro inesperado ao abrir fluxo de transferência', exc_info=exc)
            await self.cog.send_ephemeral_message(interaction, content='Erro inesperado ao abrir a transferência. Tente novamente em instantes.')

    @discord.ui.button(label='Histórico Semanal', style=discord.ButtonStyle.secondary, emoji='📊', custom_id='stock:panel:weekly', row=0)
    async def weekly_button(self, interaction: discord.Interaction, button: discord.ui.Button) -> None:
        if not self.cog.can_manage_stock(interaction):
            await self.cog.send_ephemeral_message(interaction, content='Somente a gerência pode consultar o histórico semanal.')
            return
        try:
            await self.cog.handle_weekly_history(interaction)
        except FinanceApiError as exc:
            await self.cog.send_ephemeral_message(interaction, content=f'Falha ao consultar histórico: {exc}')
        except Exception as exc:
            LOGGER.exception('Erro inesperado ao consultar histórico semanal', exc_info=exc)
            await self.cog.send_ephemeral_message(interaction, content='Erro inesperado ao consultar o histórico semanal. Tente novamente em instantes.')

