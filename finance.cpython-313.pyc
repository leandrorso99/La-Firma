class SampleBuilderView(discord.ui.View):
    def __init__(self, cog: 'StockCog', owner_user_id: int) -> None:
        super().__init__(timeout=300)
        self.cog = cog
        self.owner_user_id = owner_user_id

    @discord.ui.button(label='Adicionar Item', style=discord.ButtonStyle.primary, emoji='➕')
    async def add_item_button(self, interaction: discord.Interaction, button: discord.ui.Button) -> None:
        if interaction.user.id != self.owner_user_id:
            await interaction.response.send_message('Esse fluxo pertence a outra pessoa.', ephemeral=True)
            return
        request = self.cog.pending_sample_requests.get(interaction.user.id)
        if request is None:
            await interaction.response.edit_message(content='Registro de amostra expirado.', view=None)
            return
        await interaction.response.edit_message(content=self.cog.sample_builder_content(request, prefix='Selecione a droga do próximo item.'), view=SampleDrugSelectionView(self.cog, self.owner_user_id))

    @discord.ui.button(label='Finalizar', style=discord.ButtonStyle.success, emoji='✅')
    async def finish_button(self, interaction: discord.Interaction, button: discord.ui.Button) -> None:
        if interaction.user.id != self.owner_user_id:
            await interaction.response.send_message('Esse fluxo pertence a outra pessoa.', ephemeral=True)
            return
        request = self.cog.pending_sample_requests.get(interaction.user.id)
        if request is None:
            await interaction.response.edit_message(content='Registro de amostra expirado.', view=None)
            return
        items = request.get('items', []) if isinstance(request.get('items'), list) else []
        if not items:
            await interaction.response.send_message('Adicione pelo menos um item antes de finalizar.', ephemeral=True)
            return

        if not str(request.get('observacao', '')).strip():
            await interaction.response.edit_message(
                content=self.cog.sample_builder_content(request, prefix='Deseja adicionar alguma observação antes de finalizar?'),
                view=SampleObservationPromptView(self.cog, self.owner_user_id),
            )
            return

        await self.cog.finalize_pending_sample_request(interaction, self.owner_user_id)

    @discord.ui.button(label='Cancelar', style=discord.ButtonStyle.danger, emoji='✖')
    async def cancel_button(self, interaction: discord.Interaction, button: discord.ui.Button) -> None:
        if interaction.user.id != self.owner_user_id:
            await interaction.response.send_message('Esse fluxo pertence a outra pessoa.', ephemeral=True)
            return
        self.cog.discard_pending_sample_request(interaction.user.id)
        await interaction.response.edit_message(content='Registro de amostra cancelado.', view=None)


class StockTicketView(discord.ui.View):
    def __init__(self, cog: 'StockCog') -> None:
        super().__init__(timeout=None)
        self.cog = cog

    async def on_error(self, interaction: discord.Interaction, error: Exception, item: discord.ui.Item[Any]) -> None:
        LOGGER.exception('Erro em StockTicketView no item %s', getattr(item, 'custom_id', None), exc_info=error)
        if is_ignorable_discord_http(error):
            return
        await self.cog.send_ephemeral_message(
            interaction,
            content='Falha ao processar esta interação. Tente novamente em instantes.',
        )

