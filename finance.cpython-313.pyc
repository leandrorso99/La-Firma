class BangaloDepositStepOneModal(discord.ui.Modal):
    def __init__(self, cog: 'StockCog') -> None:
        super().__init__(title='Registrar Bangalô 1/2')
        self.cog = cog

        self.maconha = discord.ui.TextInput(label='Maconha', placeholder='0', required=False, max_length=10, default='0')
        self.cocaina = discord.ui.TextInput(label='Cocaína', placeholder='0', required=False, max_length=10, default='0')
        self.metanfetamina = discord.ui.TextInput(label='Metanfetamina', placeholder='0', required=False, max_length=10, default='0')
        self.comum = discord.ui.TextInput(label='Comum', placeholder='0', required=False, max_length=10, default='0')
        self.incomum = discord.ui.TextInput(label='Incomum', placeholder='0', required=False, max_length=10, default='0')

        self.add_item(self.maconha)
        self.add_item(self.cocaina)
        self.add_item(self.metanfetamina)
        self.add_item(self.comum)
        self.add_item(self.incomum)

    async def on_submit(self, interaction: discord.Interaction) -> None:
        try:
            payload = {
                'autor': interaction.user.display_name,
                'autor_discord_id': str(interaction.user.id),
                'bangalo_maconha': parse_int_input(str(self.maconha)),
                'bangalo_cocaina': parse_int_input(str(self.cocaina)),
                'bangalo_metanfetamina': parse_int_input(str(self.metanfetamina)),
                'bangalo_comum': parse_int_input(str(self.comum)),
                'bangalo_incomum': parse_int_input(str(self.incomum)),
            }
            self.cog.store_pending_bangalo_payload(interaction.user.id, payload)
            await interaction.response.send_message(
                'Parte 1 do Bangalô salva. Clique em Continuar Bangalô para informar Raro, Mítica e Lendária.',
                view=BangaloDepositStepTwoLauncherView(self.cog, interaction.user.id),
                ephemeral=True,
            )
        except ValueError as exc:
            await interaction.response.send_message(f'Entrada inválida: {exc}', ephemeral=True)


class BangaloDepositStepTwoModal(discord.ui.Modal):
    def __init__(self, cog: 'StockCog') -> None:
        super().__init__(title='Registrar Bangalô 2/2')
        self.cog = cog

        self.raro = discord.ui.TextInput(label='Raro', placeholder='0', required=False, max_length=10, default='0')
        self.mitica = discord.ui.TextInput(label='Mítica', placeholder='0', required=False, max_length=10, default='0')
        self.lendaria = discord.ui.TextInput(label='Lendária', placeholder='0', required=False, max_length=10, default='0')
        self.observacao = discord.ui.TextInput(
            label='Observação',
            placeholder='Ex: Reposição semanal do Bangalô',
            required=False,
            max_length=200,
            style=discord.TextStyle.long,
        )

        self.add_item(self.raro)
        self.add_item(self.mitica)
        self.add_item(self.lendaria)
        self.add_item(self.observacao)

    async def on_submit(self, interaction: discord.Interaction) -> None:
        pending = self.cog.pop_pending_bangalo_payload(interaction.user.id)
        if pending is None:
            await interaction.response.send_message('A primeira etapa expirou. Abra o fluxo do Bangalô novamente.', ephemeral=True)
            return

        try:
            payload = dict(pending)
            payload.update({
                'autor': interaction.user.display_name,
                'autor_discord_id': str(interaction.user.id),
                'bangalo_raro': parse_int_input(str(self.raro)),
                'bangalo_mitica': parse_int_input(str(self.mitica)),
                'bangalo_lendaria': parse_int_input(str(self.lendaria)),
                'observacao': str(self.observacao).strip() or 'Entrada registrada via Discord no estoque do bangalô gerência',
            })
            await self.cog.handle_manager_deposit(interaction, payload, 'bangalo')
        except ValueError as exc:
            self.cog.store_pending_bangalo_payload(interaction.user.id, pending)
            await interaction.response.send_message(f'Entrada inválida: {exc}', ephemeral=True)
        except FinanceApiError:
            self.cog.store_pending_bangalo_payload(interaction.user.id, pending)
            raise


