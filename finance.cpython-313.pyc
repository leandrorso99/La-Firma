    def default_transfer_note(self, source_scope: str, destination_scope: str) -> str:
        notes = {
            'members': 'Transferência registrada via Discord do bangalô membros',
            'favela': 'Transferência registrada via Discord do baú da favela',
            'mansoes': 'Transferência registrada via Discord do baú de mansões',
            'bangalo': 'Transferência registrada via Discord do bangalô estoque gerência',
            'bangalo2': 'Transferência registrada via Discord do bangalô 2 estoque gerência',
        }
        base = notes.get(source_scope, 'Transferência registrada via Discord')
        return base + ' para ' + self.stock_scope_name(destination_scope).lower()

    def cannabis_rarity_target_field(self, target: str, rarity: str) -> str:
        if target == 'members':
            return 'membros_' + rarity
        if target == 'mansoes':
            return 'mansoes_' + rarity
        if target == 'bangalo':
            return 'bangalo_' + rarity
        if target == 'bangalo2':
            return 'bangalo2_' + rarity
        return rarity

    def build_unified_transfer_payload(self, request: dict[str, Any], cannabis_rarity: str, interaction: discord.Interaction) -> dict[str, Any]:
        rarity = cannabis_rarity.strip().lower()
        if rarity not in {'comum', 'incomum', 'raro', 'mitica', 'lendaria'}:
            raise ValueError('Tipo de maconha inválido.')

        source_scope = str(request.get('source_scope', 'favela')).strip().lower()
        destination_scope = str(request.get('destination_scope', 'favela')).strip().lower()
        maconha_qty = int(request.get('maconha', 0) or 0)
        cocaina_qty = int(request.get('cocaina', 0) or 0)
        metanfetamina_qty = int(request.get('metanfetamina', 0) or 0)

        payload: dict[str, Any] = {
            'autor': interaction.user.display_name,
            'autor_discord_id': str(interaction.user.id),
            'observacao': str(request.get('observacao', '')).strip() or self.default_transfer_note(source_scope, destination_scope),
            'transfer_stock': True,
            'transfer_source_scope': source_scope,
            'transfer_destination_scope': destination_scope,
        }

        if source_scope == 'members':
            payload['cocaina'] = cocaina_qty
            payload['metanfetamina'] = metanfetamina_qty
        elif source_scope == 'mansoes':
            payload['mansoes_cocaina'] = cocaina_qty
            payload['mansoes_metanfetamina'] = metanfetamina_qty
        elif source_scope == 'bangalo':
            payload['bangalo_cocaina'] = cocaina_qty
            payload['bangalo_metanfetamina'] = metanfetamina_qty
        elif source_scope == 'bangalo2':
            payload['bangalo2_cocaina'] = cocaina_qty
            payload['bangalo2_metanfetamina'] = metanfetamina_qty
        else:
            payload['favela_cocaina'] = cocaina_qty
            payload['favela_metanfetamina'] = metanfetamina_qty

        if maconha_qty > 0:
            payload[self.cannabis_rarity_target_field(source_scope, rarity)] = maconha_qty

        return payload

    async def finalize_transfer_request(self, interaction: discord.Interaction, request: dict[str, Any], cannabis_rarity: str) -> None:
        payload = self.build_unified_transfer_payload(request, cannabis_rarity, interaction)
        await self.handle_manager_deposit(interaction, payload, str(request.get('source_scope', 'favela')))

    async def handle_pending_transfer_destination(self, interaction: discord.Interaction, destination_scope: str) -> None:
        request = self.pending_transfer_requests.get(interaction.user.id)
        if request is None:
            await interaction.response.send_message('A solicitação expirou. Abra o fluxo novamente.', ephemeral=True)
            return

        source_scope = str(request.get('source_scope', '')).strip().lower()
        if destination_scope == source_scope:
            await interaction.response.send_message('Escolha um baú de destino diferente do baú de origem.', ephemeral=True)
            return

        request['destination_scope'] = destination_scope
        self.store_pending_transfer_request(interaction.user.id, request)

        if int(request.get('maconha', 0) or 0) > 0:
            await interaction.response.edit_message(
                content='Deseja informar qual é o tipo da maconha? Se escolher não, ela será transferida como Comum.',
                view=CannabisTypeDecisionView(self, interaction.user.id),
            )
            return

        request = self.pop_pending_transfer_request(interaction.user.id)
        if request is None:
            await interaction.response.send_message('A solicitação expirou. Abra o fluxo novamente.', ephemeral=True)
            return
        await self.finalize_transfer_request(interaction, request, 'comum')

    async def finalize_pending_transfer(self, interaction: discord.Interaction, cannabis_rarity: str) -> None:
        request = self.pop_pending_transfer_request(interaction.user.id)
        if request is None:
            await interaction.response.send_message('A solicitação expirou. Abra o fluxo novamente.', ephemeral=True)
            return
        await self.finalize_transfer_request(interaction, request, cannabis_rarity)

