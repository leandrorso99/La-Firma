class SampleQuantityModal(discord.ui.Modal):
    def __init__(self, cog: 'StockCog', drug_type: str) -> None:
        super().__init__(title='Quantidade do Item')
        self.cog = cog
        self.drug_type = drug_type

        self.quantity = discord.ui.TextInput(label='Quantidade', placeholder='0', required=True, max_length=10, default='0')
        self.add_item(self.quantity)

    async def on_submit(self, interaction: discord.Interaction) -> None:
        try:
            quantity = parse_int_input(str(self.quantity))
            if quantity <= 0:
                raise ValueError('Informe uma quantidade maior que zero.')

            request = self.cog.pending_sample_requests.get(interaction.user.id)
            if request is None:
                await interaction.response.send_message('O fluxo expirou. Abra o registro novamente.', ephemeral=True)
                return

            request['draft_item'] = {
                'drug_type': self.drug_type,
                'quantity': quantity,
            }
            self.cog.store_pending_sample_request(interaction.user.id, request)

            if self.drug_type in {'maconha', 'cocaina'}:
                await interaction.response.send_message(
                    'Selecione a raridade do item.',
                    view=SampleRaritySelectionView(self.cog, interaction.user.id),
                    ephemeral=True,
                )
                return

            await interaction.response.send_message(
                'Selecione o baú de origem do item.',
                view=SampleSourceSelectionView(self.cog, interaction.user.id),
                ephemeral=True,
            )
        except ValueError as exc:
            await interaction.response.send_message(f'Entrada inválida: {exc}', ephemeral=True)


