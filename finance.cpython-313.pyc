class MemberWithdrawalModal(discord.ui.Modal):
    def __init__(self, cog: 'StockCog') -> None:
        super().__init__(title='Registrar Retirada')
        self.cog = cog

        self.comum = discord.ui.TextInput(label='Maconha', placeholder='0', required=False, max_length=10, default='0')
        self.cocaina = discord.ui.TextInput(label='Cocaína', placeholder='0', required=False, max_length=10, default='0')
        self.metanfetamina = discord.ui.TextInput(label='Metanfetamina', placeholder='0', required=False, max_length=10, default='0')
        self.observacao = discord.ui.TextInput(
            label='Observação',
            placeholder='Ex: retirada da rota',
            required=False,
            max_length=200,
            style=discord.TextStyle.long,
        )

        self.add_item(self.comum)
        self.add_item(self.cocaina)
        self.add_item(self.metanfetamina)
        self.add_item(self.observacao)

    async def on_submit(self, interaction: discord.Interaction) -> None:
        try:
            maconha_qty = parse_int_input(str(self.comum))
            payload = {
                'autor': interaction.user.display_name,
                'autor_discord_id': str(interaction.user.id),
                'ticket_channel_id': str(interaction.channel_id),
                'maconha': maconha_qty,
                'cocaina': parse_int_input(str(self.cocaina)),
                'metanfetamina': parse_int_input(str(self.metanfetamina)),
                'observacao': str(self.observacao).strip(),
            }

            if maconha_qty > 0:
                await self.cog.clear_member_withdrawal_prompt(
                    interaction.user.id,
                    interaction.channel_id,
                    content='Seleção anterior de tipo de maconha substituída por um novo registro.',
                )
                self.cog.store_pending_member_withdrawal_payload(interaction.user.id, payload)
                await interaction.response.send_message(
                    'Selecione o tipo da maconha retirada do baú dos membros.',
                    view=MemberWithdrawalCannabisTypeView(self.cog, interaction.user.id),
                    ephemeral=True,
                )
                try:
                    prompt_message = await interaction.original_response()
                except (discord.NotFound, discord.HTTPException):
                    prompt_message = None
                if prompt_message is not None:
                    self.cog.store_member_withdrawal_prompt(interaction.user.id, interaction.channel_id, prompt_message)
                return

            await self.cog.handle_member_withdrawal(interaction, payload)
        except ValueError as exc:
            await self.cog.send_ephemeral_message(interaction, content=f'Entrada inválida: {exc}')
        except FinanceApiError as exc:
            await self.cog.send_ephemeral_message(
                interaction,
                content=self.cog.stock_action_error_message('registrar retirada', exc),
            )


class SampleInfoModal(discord.ui.Modal):
    def __init__(self, cog: 'StockCog', member_name: str) -> None:
        super().__init__(title='Registrar Amostra')
        self.cog = cog

        self.member_name = discord.ui.TextInput(label='Membro', required=True, max_length=150, default=member_name)

        self.add_item(self.member_name)

    async def on_submit(self, interaction: discord.Interaction) -> None:
        request = {
            'member_name': str(self.member_name).strip(),
            'observacao': '',
            'items': [],
        }
        self.cog.store_pending_sample_request(interaction.user.id, request)
        await interaction.response.send_message(
            self.cog.sample_builder_content(request),
            view=SampleBuilderView(self.cog, interaction.user.id),
            ephemeral=True,
        )


class SampleObservationModal(discord.ui.Modal):
    def __init__(self, cog: 'StockCog', owner_user_id: int) -> None:
        super().__init__(title='Observação da Amostra')
        self.cog = cog
        self.owner_user_id = owner_user_id
        self.observacao = discord.ui.TextInput(
            label='Observação',
            placeholder='Ex: amostra para teste interno',
            required=True,
            max_length=200,
            style=discord.TextStyle.long,
        )
        self.add_item(self.observacao)

    async def on_submit(self, interaction: discord.Interaction) -> None:
        if interaction.user.id != self.owner_user_id:
            await interaction.response.send_message('Esse fluxo pertence a outra pessoa.', ephemeral=True)
            return
        request = self.cog.pending_sample_requests.get(interaction.user.id)
        if request is None:
            await interaction.response.send_message('Registro de amostra expirado.', ephemeral=True)
            return
        request['observacao'] = str(self.observacao).strip()
        self.cog.store_pending_sample_request(interaction.user.id, request)
        await self.cog.finalize_pending_sample_request(interaction, self.owner_user_id)


class SampleObservationPromptView(discord.ui.View):
    def __init__(self, cog: 'StockCog', owner_user_id: int) -> None:
        super().__init__(timeout=300)
        self.cog = cog
        self.owner_user_id = owner_user_id

    @discord.ui.button(label='Sim', style=discord.ButtonStyle.primary, emoji='📝')
    async def yes_button(self, interaction: discord.Interaction, button: discord.ui.Button) -> None:
        if interaction.user.id != self.owner_user_id:
            await interaction.response.send_message('Esse fluxo pertence a outra pessoa.', ephemeral=True)
            return
        await interaction.response.send_modal(SampleObservationModal(self.cog, self.owner_user_id))

    @discord.ui.button(label='Não', style=discord.ButtonStyle.success, emoji='✅')
    async def no_button(self, interaction: discord.Interaction, button: discord.ui.Button) -> None:
        if interaction.user.id != self.owner_user_id:
            await interaction.response.send_message('Esse fluxo pertence a outra pessoa.', ephemeral=True)
            return
        await self.cog.finalize_pending_sample_request(interaction, self.owner_user_id)

    @discord.ui.button(label='Voltar', style=discord.ButtonStyle.secondary, emoji='↩')
    async def back_button(self, interaction: discord.Interaction, button: discord.ui.Button) -> None:
        if interaction.user.id != self.owner_user_id:
            await interaction.response.send_message('Esse fluxo pertence a outra pessoa.', ephemeral=True)
            return
        request = self.cog.pending_sample_requests.get(interaction.user.id)
        if request is None:
