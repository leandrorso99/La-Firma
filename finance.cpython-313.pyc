class TransferDestinationSelect(discord.ui.Select):
    def __init__(self, cog: 'StockCog', owner_user_id: int, source_scope: str) -> None:
        labels = {
            'members': ('Bangalô Membros', 'Bangalô Membros'),
            'favela': ('Favela', 'Baú da Favela'),
            'bangalo': ('Bangalô Estoque Gerência', 'Bangalô Estoque Gerência'),
            'bangalo2': ('Bangalô 2 Estoque Gerência', 'Bangalô 2 Estoque Gerência'),
            'mansoes': ('Mansões', 'Baú de Mansões'),
        }
        options = [
            discord.SelectOption(label=label, value=value, description=description)
            for value, (label, description) in labels.items()
            if value != source_scope
