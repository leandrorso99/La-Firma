logger = logging.getLogger(__name__)


SALE_SCOPE_LABELS: dict[str, str] = {
    'favela': 'Favela',
    'bangalo': 'Bangalô',
    'mansoes': 'Mansões',
    'members': 'Membros',
}


def money_text(value: float) -> str:
    return f'R$ {value:,.2f}'.replace(',', 'X').replace('.', ',').replace('X', '.')


def xp_text(value: float) -> str:
    return f'{value:,.0f}'.replace(',', 'X').replace('.', ',').replace('X', '.')


def split_message_chunks(text: str, limit: int = 1900) -> list[str]:
    content = text.strip()
    if not content:
        return []

    if len(content) <= limit:
        return [content]

    chunks: list[str] = []
    current = ''
    for line in content.splitlines():
        candidate = line if not current else current + '\n' + line
        if len(candidate) <= limit:
            current = candidate
            continue
        if current:
            chunks.append(current)
        current = line

    if current:
        chunks.append(current)

    return chunks


def parse_money_input(raw: str) -> float:
    value = raw.strip().replace('R$', '').replace(' ', '')
    if not value:
        raise ValueError('Valor vazio.')
    if ',' in value and '.' in value:
        value = value.replace('.', '').replace(',', '.')
    else:
        value = value.replace(',', '.')
    amount = float(value)
    if amount <= 0:
        raise ValueError('Valor deve ser maior que zero.')
    return amount


def parse_int_input(raw: str) -> int:
    value = raw.strip()
    if value == '':
        return 0
    parsed = int(value)
    if parsed < 0:
        raise ValueError('Quantidade não pode ser negativa.')
    return parsed


class TransactionModal(discord.ui.Modal):
    def __init__(self, cog: 'FinanceCog', tx_type: str) -> None:
        title_map = {
            'deposito': 'Depósito no Cofre',
            'pagamento': 'Pagamento do Cofre',
            'saque': 'Saque do Cofre',
        }
        super().__init__(title=title_map.get(tx_type, 'Lançamento Financeiro'))
        self.cog = cog
        self.tx_type = tx_type

        self.amount = discord.ui.TextInput(
            label='Valor',
            placeholder='Apenas números ou decimal. Ex: 5000 ou 5000,50',
            required=True,
            max_length=20,
        )
        self.reason = discord.ui.TextInput(
            label='Descrição / Origem',
            placeholder='Descreva a transação...',
            required=True,
            max_length=200,
        )

        self.add_item(self.amount)
        self.add_item(self.reason)

    async def on_submit(self, interaction: discord.Interaction) -> None:
        try:
            amount = parse_money_input(str(self.amount))
            reason = str(self.reason).strip()
            await interaction.response.defer(ephemeral=True)
            await self.cog.handle_transaction(interaction, self.tx_type, amount, reason)
        except ValueError as exc:
            await self.cog.send_ephemeral_message(interaction, content=f'Entrada inválida: {exc}')
        except FinanceApiError as exc:
            await self.cog.send_ephemeral_message(interaction, content=f'Falha ao registrar {self.tx_type}: {exc}')


class ClientModal(discord.ui.Modal):
    def __init__(self, cog: 'FinanceCog', action: str) -> None:
        title = 'Cadastrar Família' if action == 'create' else 'Remover Família'
        super().__init__(title=title)
        self.cog = cog
        self.action = action
        self.client_name = discord.ui.TextInput(
            label='Nome da família',
            placeholder='Ex: Ballas, Camorra, etc.',
            required=True,
            max_length=150,
        )
        self.add_item(self.client_name)

    async def on_submit(self, interaction: discord.Interaction) -> None:
        name = str(self.client_name).strip()
        try:
            await interaction.response.defer(ephemeral=True)
            if self.action == 'create':
                await self.cog.handle_create_client(interaction, name)
            else:
                await self.cog.handle_delete_client(interaction, name)
        except FinanceApiError as exc:
            await self.cog.send_ephemeral_message(interaction, content=f'Falha ao processar família: {exc}')


class SaleQuantitiesModal(discord.ui.Modal):
    def __init__(self, cog: 'FinanceCog', client_name: str, stock_scope: str, target_type: str = 'family') -> None:
        super().__init__(title='Registrar Venda')
        self.cog = cog
        self.client_name = client_name
        self.stock_scope = stock_scope
        self.target_type = target_type

        self.common = discord.ui.TextInput(label='Quantidade Comum', placeholder='0', required=False, max_length=10, default='0')
        self.uncommon = discord.ui.TextInput(label='Quantidade Incomum', placeholder='0', required=False, max_length=10, default='0')
        self.rare = discord.ui.TextInput(label='Quantidade Rara', placeholder='0', required=False, max_length=10, default='0')
        self.mythic = discord.ui.TextInput(label='Quantidade Mítica', placeholder='0', required=False, max_length=10, default='0')
        self.legendary = discord.ui.TextInput(label='Quantidade Lendária', placeholder='0', required=False, max_length=10, default='0')

        self.add_item(self.common)
        self.add_item(self.uncommon)
        self.add_item(self.rare)
        self.add_item(self.mythic)
        self.add_item(self.legendary)

    async def on_submit(self, interaction: discord.Interaction) -> None:
        try:
            payload = {
                'autor': interaction.user.display_name,
                'cliente': self.client_name,
                'target_type': self.target_type,
                'bau_origem': self.stock_scope,
                'source': 'discord',
                'q_comum': parse_int_input(str(self.common)),
                'q_incomum': parse_int_input(str(self.uncommon)),
                'q_rara': parse_int_input(str(self.rare)),
                'q_mitica': parse_int_input(str(self.mythic)),
                'q_lendaria': parse_int_input(str(self.legendary)),
            }
            await interaction.response.defer(ephemeral=True)
            await self.cog.handle_sale(interaction, payload)
        except ValueError as exc:
            await self.cog.send_ephemeral_message(interaction, content=f'Entrada inválida: {exc}')
        except FinanceApiError as exc:
            await self.cog.send_ephemeral_message(interaction, content=f'Falha ao registrar venda: {exc}')


class ClientSelect(discord.ui.Select):
    def __init__(self, cog: 'FinanceCog', clients: list[str]) -> None:
        options = [discord.SelectOption(label=name[:100], value=name, description='Família cadastrada no site') for name in clients[:25]]
        super().__init__(placeholder='Selecione a família para a venda', min_values=1, max_values=1, options=options)
        self.cog = cog

    async def callback(self, interaction: discord.Interaction) -> None:
        await self.cog.send_ephemeral_message(
            interaction,
            content='Selecione o baú de onde a droga foi retirada.',
            view=SaleChestSelectionView(self.cog, self.values[0], 'family'),
        )


class ClientSelectionView(discord.ui.View):
    def __init__(self, cog: 'FinanceCog', clients: list[str]) -> None:
        super().__init__(timeout=120)
        self.add_item(ClientSelect(cog, clients))


