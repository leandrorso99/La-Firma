        except FinanceApiError as exc:
            await self.send_ephemeral_message(interaction, content=f'Falha ao registrar saque: {exc}')

    @app_commands.command(name='pagamento', description='Registra um pagamento no financeiro do site.')
    @app_commands.describe(valor='Valor do pagamento', motivo='Descrição do pagamento')
    async def pagamento(self, interaction: discord.Interaction, valor: app_commands.Range[float, 0.01], motivo: str) -> None:
        try:
            await self.handle_transaction(interaction, 'pagamento', float(valor), motivo.strip())
        except FinanceApiError as exc:
            await self.send_ephemeral_message(interaction, content=f'Falha ao registrar pagamento: {exc}')

    @app_commands.command(name='venda', description='Registra uma venda para família ou Vapo no painel financeiro.')
    @app_commands.describe(
        cliente='Família cadastrada no site ou Vapo',
        destino='Escolha se a venda é para família ou Vapo',
        bau_origem='Baú de onde a droga foi retirada',
        comum='Quantidade de comum',
        incomum='Quantidade de incomum',
        rara='Quantidade de rara',
        mitica='Quantidade de mítica',
        lendaria='Quantidade de lendária',
    )
    @app_commands.choices(
        destino=[
            app_commands.Choice(name='Família', value='family'),
            app_commands.Choice(name='Vapo', value='vapo'),
        ],
        bau_origem=[
            app_commands.Choice(name='Favela', value='favela'),
            app_commands.Choice(name='Bangalô', value='bangalo'),
            app_commands.Choice(name='Mansões', value='mansoes'),
            app_commands.Choice(name='Membros', value='members'),
        ]
    )
    async def venda(
        self,
        interaction: discord.Interaction,
        cliente: str,
        destino: app_commands.Choice[str],
        bau_origem: app_commands.Choice[str],
        comum: app_commands.Range[int, 0] = 0,
        incomum: app_commands.Range[int, 0] = 0,
        rara: app_commands.Range[int, 0] = 0,
        mitica: app_commands.Range[int, 0] = 0,
        lendaria: app_commands.Range[int, 0] = 0,
    ) -> None:
        payload = {
            'autor': interaction.user.display_name,
            'cliente': 'Vapo' if destino.value == 'vapo' else cliente.strip(),
            'target_type': destino.value,
            'bau_origem': bau_origem.value,
            'source': 'discord',
            'q_comum': int(comum),
            'q_incomum': int(incomum),
            'q_rara': int(rara),
            'q_mitica': int(mitica),
            'q_lendaria': int(lendaria),
        }

        try:
            await self.handle_sale(interaction, payload)
        except FinanceApiError as exc:
            await self.send_ephemeral_message(interaction, content=f'Falha ao registrar venda: {exc}')


async def setup(bot: commands.Bot) -> None:
    await bot.add_cog(FinanceCog(bot))
