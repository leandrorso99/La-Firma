class SaleTargetSelectionView(discord.ui.View):
    def __init__(self, cog: 'FinanceCog') -> None:
        super().__init__(timeout=120)
        self.cog = cog

    @discord.ui.button(label='Família', style=discord.ButtonStyle.primary, emoji='👥')
    async def family_button(self, interaction: discord.Interaction, button: discord.ui.Button) -> None:
        try:
            clients = await self.cog.fetch_clients()
        except FinanceApiError as exc:
            await self.cog.send_ephemeral_message(interaction, content=f'Falha ao carregar famílias: {exc}')
            return

        if not clients:
            await self.cog.send_ephemeral_message(interaction, content='Nenhuma família cadastrada no site. Cadastre uma família antes de registrar a venda.')
            return

        view = ClientSelectionView(self.cog, clients)
        suffix = '' if len(clients) <= 25 else f' Mostrando as 25 primeiras de {len(clients)} famílias.'
        await self.cog.send_ephemeral_message(interaction, content=f'Selecione a família para continuar.{suffix}', view=view)

    @discord.ui.button(label='Vapo', style=discord.ButtonStyle.success, emoji='💨')
    async def vapo_button(self, interaction: discord.Interaction, button: discord.ui.Button) -> None:
        await self.cog.send_ephemeral_message(
            interaction,
            content='Selecione o baú de onde a droga foi retirada para registrar no Vapo.',
            view=SaleChestSelectionView(self.cog, 'Vapo', 'vapo'),
        )


