LOGGER = logging.getLogger(__name__)


def role_ids_from_config(name: str) -> set[int]:
    values = getattr(config, name, []) or []
    parsed: set[int] = set()
    for value in values:
        try:
            role_id = int(value)
        except (TypeError, ValueError):
            continue
        if role_id > 0:
            parsed.add(role_id)
    return parsed


def has_any_role(member: discord.Member, role_ids: set[int]) -> bool:
    if not role_ids:
        return False
    return any(role.id in role_ids for role in member.roles)


def vehicle_status_emoji(status: str) -> str:
    mapping = {
        'available': '✅',
        'checked_out': '🚗',
        'detained': '🚨',
        'inactive': '⛔',
    }
    return mapping.get(status, '•')


def bool_from_text(value: str) -> bool:
    normalized = value.strip().lower()
    return normalized in {'1', 'sim', 's', 'true', 'yes', 'y'}


def format_vehicle_timestamp(value: Any) -> str:
    raw = str(value or '').strip()
    if raw == '':
        return ''

    for fmt in ('%Y-%m-%d %H:%M:%S', '%Y-%m-%d %H:%M:%S.%f'):
        try:
            parsed = datetime.strptime(raw, fmt)
            return parsed.strftime('%d/%m/%Y %H:%M')
        except ValueError:
            continue

    return raw


def format_vexp_date(value: Any) -> str:
    raw = str(value or '').strip()
    if raw == '':
        return ''
    for fmt in ('%Y-%m-%d', '%d/%m/%Y'):
        try:
            parsed = datetime.strptime(raw, fmt)
            return parsed.strftime('%d/%m/%Y')
        except ValueError:
            continue
    return raw


def build_vexp_notification_message(row: dict[str, Any], reminder_days: int, *, simulation: bool = False) -> str:
    vehicle_name = str(row.get('vehicle_name', 'Veículo')).strip() or 'Veículo'
    duration_days = int(row.get('duration_days', 0) or 0)
    purchased_at = format_vexp_date(row.get('purchased_at')) or 'Não informado'
    expires_at = format_vexp_date(row.get('expires_at')) or 'Não informado'

    if reminder_days <= 0:
        headline = 'vence hoje'
    elif reminder_days == 1:
        headline = 'vence amanhã'
    else:
        headline = f'vence em {reminder_days} dias'

    lines = [
        'Aviso de vencimento de veículo.',
        '',
        f'Veículo: {vehicle_name}',
        f'Comprado em: {purchased_at}',
        f'Duração: {duration_days} dias',
        f'Vencimento: {expires_at}',
        f'Status: {headline}.',
        '',
        'Renove o registro do veículo para evitar perder o acesso.',
    ]
    if simulation:
        lines.insert(0, '[SIMULAÇÃO]')
    return '\n'.join(lines)


class VehicleRegisterModal(discord.ui.Modal):
    def __init__(self, cog: 'VehicleCog') -> None:
        super().__init__(title='Cadastrar Veículo')
        self.cog = cog
        self.vehicle_name = discord.ui.TextInput(
            label='Nome/modelo do veículo',
            placeholder='Ex: Sultan RS, Banshee, Sprinter',
            required=True,
            max_length=191,
        )
        self.vehicle_plate = discord.ui.TextInput(
            label='Placa do veículo',
            placeholder='Ex: ABC1D23 ou ABC-1234',
            required=True,
            max_length=16,
        )
        self.add_item(self.vehicle_name)
        self.add_item(self.vehicle_plate)

    async def on_submit(self, interaction: discord.Interaction) -> None:
        try:
            await interaction.response.defer(ephemeral=True)
            await self.cog.register_vehicle(
                interaction,
                str(self.vehicle_name).strip(),
                str(self.vehicle_plate).strip(),
            )
        except FinanceApiError as exc:
            await self.cog.send_ephemeral_message(interaction, content=f'Falha ao cadastrar veículo: {exc}')


class VehicleReturnModal(discord.ui.Modal):
    def __init__(self, cog: 'VehicleCog', vehicle_row: dict[str, Any], detained: bool) -> None:
        super().__init__(title='Devolver Veículo')
        self.cog = cog
        self.vehicle_row = vehicle_row
        self.detained = detained
        self.note = discord.ui.TextInput(
            label='Observação',
            placeholder='Ex: tanque vazio, sem danos, detido na praça',
            required=False,
            max_length=255,
            style=discord.TextStyle.long,
        )
        self.add_item(self.note)

    async def on_submit(self, interaction: discord.Interaction) -> None:
        try:
            await interaction.response.defer(ephemeral=True)
            await self.cog.return_vehicle(interaction, self.vehicle_row, self.detained, str(self.note).strip())
        except FinanceApiError as exc:
            await self.cog.send_ephemeral_message(interaction, content=f'Falha ao devolver veículo: {exc}')


class VehicleReturnDetainedSelect(discord.ui.Select):
    def __init__(self, view: 'VehicleReturnDecisionView') -> None:
        self.decision_view = view
        options = [
            discord.SelectOption(label='Não', value='no', description='O veículo voltou normalmente.', default=True),
            discord.SelectOption(label='Sim', value='yes', description='O veículo foi detido na devolução.', default=False),
        ]
        super().__init__(
            placeholder='Selecione se o veículo foi detido',
            min_values=1,
            max_values=1,
            options=options,
        )

    async def callback(self, interaction: discord.Interaction) -> None:
        self.decision_view.detained = self.values[0] == 'yes'
        for option in self.options:
            option.default = option.value == self.values[0]
        await interaction.response.edit_message(view=self.decision_view)


class VehicleReturnDecisionView(discord.ui.View):
    def __init__(self, cog: 'VehicleCog', vehicle_row: dict[str, Any]) -> None:
        super().__init__(timeout=120)
        self.cog = cog
        self.vehicle_row = vehicle_row
        self.detained = False
        self.add_item(VehicleReturnDetainedSelect(self))

    @discord.ui.button(label='Continuar', style=discord.ButtonStyle.primary, emoji='↩️')
    async def continue_button(self, interaction: discord.Interaction, button: discord.ui.Button) -> None:
        await interaction.response.send_modal(VehicleReturnModal(self.cog, self.vehicle_row, self.detained))


