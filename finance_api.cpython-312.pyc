class VehicleSelect(discord.ui.Select):
    def __init__(self, cog: 'VehicleCog', rows: list[dict[str, Any]], mode: str) -> None:
        self.cog = cog
        self.rows = rows
        self.mode = mode
        options: list[discord.SelectOption] = []

        for row in rows[:25]:
            vehicle_id = int(row.get('id', 0) or 0)
            if vehicle_id <= 0:
                continue
            name = str(row.get('name', 'Veículo')).strip() or 'Veículo'
            plate = str(row.get('plate', '') or '').strip()
            status = str(row.get('status_label', row.get('status', ''))).strip()
            description = f'Placa: {plate}' if plate else status
            if mode == 'checkout':
                last_holder = str(row.get('last_holder_name', '') or '').strip()
                if last_holder:
                    description = f'Placa: {plate} | Último: {last_holder}' if plate else f'Último responsável: {last_holder}'
            elif mode == 'return':
                current_holder = str(row.get('current_holder_name', '') or '').strip()
                if current_holder:
                    description = f'Placa: {plate} | Em posse de: {current_holder}' if plate else f'Em posse de: {current_holder}'
            elif mode == 'release':
                last_holder = str(row.get('last_holder_name', '') or '').strip()
                if last_holder:
                    description = f'Placa: {plate} | Último: {last_holder}' if plate else f'Último responsável: {last_holder}'
            elif mode == 'deactivate':
                last_holder = str(row.get('last_holder_name', '') or '').strip()
                if last_holder:
                    description = f'Placa: {plate} | Último: {last_holder}' if plate else f'Último responsável: {last_holder}'
            elif mode == 'reactivate':
                description = f'Placa: {plate}' if plate else 'Veículo removido do cadastro'

            options.append(discord.SelectOption(label=name[:100], value=str(vehicle_id), description=description[:100]))

        placeholder_map = {
            'checkout': 'Selecione o veículo para retirar',
            'return': 'Selecione o veículo para devolver',
            'release': 'Selecione o veículo detido para liberar',
            'deactivate': 'Selecione o veículo para remover do cadastro',
            'reactivate': 'Selecione o veículo para reativar no cadastro',
        }
        super().__init__(placeholder=placeholder_map.get(mode, 'Selecione um veículo'), min_values=1, max_values=1, options=options)

    async def callback(self, interaction: discord.Interaction) -> None:
        vehicle_id = int(self.values[0])
        selected = next((row for row in self.rows if int(row.get('id', 0) or 0) == vehicle_id), None)
        if not selected:
            await self.cog.send_ephemeral_message(interaction, content='Veículo não encontrado na lista atual.')
            return

        try:
            if self.mode == 'checkout':
                await interaction.response.defer(ephemeral=True)
                await self.cog.checkout_vehicle(interaction, selected)
                return

            if self.mode == 'return':
                await interaction.response.defer(ephemeral=True)
                await self.cog.send_ephemeral_message(
                    interaction,
                    content='Selecione se o veículo foi detido e depois continue para informar uma observação, se quiser.',
                    view=VehicleReturnDecisionView(self.cog, selected),
                )
                return

            if self.mode == 'release':
                await interaction.response.defer(ephemeral=True)
                await self.cog.release_vehicle(interaction, selected)
                return

            if self.mode == 'deactivate':
                await interaction.response.defer(ephemeral=True)
                await self.cog.send_ephemeral_message(
                    interaction,
                    content='Confirme que deseja remover esse veículo do cadastro. Essa ação mantém o histórico, mas oculta o veículo dos fluxos normais.',
                    view=VehicleDeactivateConfirmView(self.cog, selected),
                )
                return

            if self.mode == 'reactivate':
                await interaction.response.defer(ephemeral=True)
                await self.cog.reactivate_vehicle(interaction, selected)
        except FinanceApiError as exc:
            await self.cog.send_ephemeral_message(interaction, content=f'Falha no fluxo do veículo: {exc}')


