            await self.cog.send_ephemeral_message(interaction, content='Apenas ADM/gerência pode liberar veículo detido.')
            return
        try:
            await self.cog.start_release_flow(interaction)
        except FinanceApiError as exc:
            await self.cog.send_ephemeral_message(interaction, content=f'Falha ao carregar veículos detidos: {exc}')

    @discord.ui.button(label='Remover Veículo', style=discord.ButtonStyle.danger, emoji='🗑️', custom_id='vehicles:deactivate')
