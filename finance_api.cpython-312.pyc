class VehicleExpirationRegisterModal(discord.ui.Modal):
    def __init__(self, cog: 'VehicleCog') -> None:
        super().__init__(title='Cadastrar Vencimento de Veículo')
        self.cog = cog
        self.vehicle_name = discord.ui.TextInput(
            label='Nome/modelo do veículo',
            placeholder='Ex: Sultan RS, Banshee, Sprinter',
            required=True,
            max_length=191,
        )
        self.purchased_at = discord.ui.TextInput(
            label='Data da compra',
            placeholder='Ex: 07/04/2026',
            required=True,
            max_length=10,
        )
        self.duration_days = discord.ui.TextInput(
            label='Dias do contrato',
            placeholder='Ex: 7, 15, 30 ou outro valor',
            required=True,
            max_length=4,
        )
        self.add_item(self.vehicle_name)
        self.add_item(self.purchased_at)
        self.add_item(self.duration_days)

    async def on_submit(self, interaction: discord.Interaction) -> None:
        try:
            duration_days = int(str(self.duration_days).strip())
        except ValueError:
            await self.cog.send_ephemeral_message(interaction, content='Informe um número válido de dias para o contrato.')
            return

        try:
            await interaction.response.defer(ephemeral=True)
            await self.cog.register_vexp(
                interaction,
                str(self.vehicle_name).strip(),
                str(self.purchased_at).strip(),
                duration_days,
            )
        except FinanceApiError as exc:
            await self.cog.send_ephemeral_message(interaction, content=f'Falha ao cadastrar vencimento: {exc}')


class VehicleExpirationRecipientSelect(discord.ui.UserSelect):
    def __init__(self, parent_view: 'VehicleExpirationRecipientView') -> None:
        self.parent_view = parent_view
        super().__init__(placeholder='Selecione quem vai receber os avisos', min_values=1, max_values=10)

    async def callback(self, interaction: discord.Interaction) -> None:
        self.parent_view.selected_user_ids = [str(user.id) for user in self.values]
        self.parent_view.selected_labels = [user.display_name for user in self.values]
        await interaction.response.edit_message(embed=self.parent_view.current_embed(), view=self.parent_view)


class VehicleExpirationRecipientView(discord.ui.View):
    def __init__(self, cog: 'VehicleCog', selected_user_ids: list[str]) -> None:
        super().__init__(timeout=180)
        self.cog = cog
        self.selected_user_ids = selected_user_ids[:]
        self.selected_labels: list[str] = []
        self.add_item(VehicleExpirationRecipientSelect(self))

    def current_embed(self) -> discord.Embed:
        description = 'Selecione os usuários do Discord que receberão DM automática quando um vencimento de veículo estiver perto de expirar.'
        selected_text = '\n'.join(f'- <@{uid}>' for uid in self.selected_user_ids) if self.selected_user_ids else 'Nenhum usuário selecionado.'
        embed = discord.Embed(title='Destinatários dos Avisos de Vencimento de Veículo', description=description, color=0x6EA8FE)
        embed.add_field(name='Selecionados', value=selected_text, inline=False)
        return embed

    @discord.ui.button(label='Salvar Destinatários', style=discord.ButtonStyle.success, emoji='💾')
    async def save_button(self, interaction: discord.Interaction, button: discord.ui.Button) -> None:
        await interaction.response.defer(ephemeral=True)
        await self.cog.save_vexp_recipients(interaction, self.selected_user_ids)

    @discord.ui.button(label='Cancelar', style=discord.ButtonStyle.secondary)
    async def cancel_button(self, interaction: discord.Interaction, button: discord.ui.Button) -> None:
        await interaction.response.edit_message(content='Seleção de destinatários cancelada.', embed=None, view=None)


class VehicleExpirationSimulationSelect(discord.ui.Select):
    def __init__(self, cog: 'VehicleCog', rows: list[dict[str, Any]]) -> None:
        self.cog = cog
        self.rows = rows
        options: list[discord.SelectOption] = []

        for row in rows[:25]:
            contract_id = int(row.get('id', 0) or 0)
            if contract_id <= 0:
                continue
            vehicle_name = str(row.get('vehicle_name', 'Veículo')).strip() or 'Veículo'
            expires_at = format_vexp_date(row.get('expires_at'))
            days_remaining = int(row.get('days_remaining', 0) or 0)
            if days_remaining < 0:
                description = f'Venceu em {expires_at}'
            elif days_remaining == 0:
                description = f'Vence hoje | {expires_at}'
            elif days_remaining == 1:
                description = f'Vence amanhã | {expires_at}'
            else:
                description = f'Vence em {days_remaining} dias | {expires_at}'
            options.append(discord.SelectOption(label=vehicle_name[:100], value=str(contract_id), description=description[:100]))

        super().__init__(placeholder='Selecione o veículo para simular o aviso', min_values=1, max_values=1, options=options)

    async def callback(self, interaction: discord.Interaction) -> None:
        contract_id = int(self.values[0])
        selected = next((r for r in self.rows if int(r.get('id', 0) or 0) == contract_id), None)
        if not selected:
            await self.cog.send_ephemeral_message(interaction, content='Veículo não encontrado na lista atual.')
            return
        try:
            await interaction.response.defer(ephemeral=True)
            await self.cog.simulate_vexp_notification(interaction, selected)
        except FinanceApiError as exc:
            await self.cog.send_ephemeral_message(interaction, content=f'Falha ao simular aviso: {exc}')


class VehicleExpirationSimulationView(discord.ui.View):
    def __init__(self, cog: 'VehicleCog', rows: list[dict[str, Any]]) -> None:
        super().__init__(timeout=120)
        self.add_item(VehicleExpirationSimulationSelect(cog, rows))


class VehicleExpirationDeleteSelect(discord.ui.Select):
    def __init__(self, cog: 'VehicleCog', rows: list[dict[str, Any]]) -> None:
        self.cog = cog
        self.rows = rows
        options: list[discord.SelectOption] = []

        for row in rows[:25]:
            contract_id = int(row.get('id', 0) or 0)
            if contract_id <= 0:
                continue
            vehicle_name = str(row.get('vehicle_name', 'Veículo')).strip() or 'Veículo'
            expires_at = format_vexp_date(row.get('expires_at')) or 'Sem vencimento'
            options.append(discord.SelectOption(label=vehicle_name[:100], value=str(contract_id), description=f'Vence em: {expires_at}'[:100]))

        super().__init__(placeholder='Selecione o veículo para remover', min_values=1, max_values=1, options=options)

    async def callback(self, interaction: discord.Interaction) -> None:
        contract_id = int(self.values[0])
        selected = next((r for r in self.rows if int(r.get('id', 0) or 0) == contract_id), None)
        if not selected:
            await self.cog.send_ephemeral_message(interaction, content='Veículo não encontrado na lista atual.')
            return
        try:
            await interaction.response.defer(ephemeral=True)
            await self.cog.delete_vexp(interaction, selected)
        except FinanceApiError as exc:
            await self.cog.send_ephemeral_message(interaction, content=f'Falha ao remover vencimento: {exc}')


