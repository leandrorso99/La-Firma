class VehicleAdminPanelView(discord.ui.View):
    def __init__(self, cog: 'VehicleCog') -> None:
        super().__init__(timeout=None)
        self.cog = cog

    @discord.ui.button(label='Cadastrar Veículo', style=discord.ButtonStyle.primary, emoji='🧾', custom_id='vehicles:register')
    async def register_button(self, interaction: discord.Interaction, button: discord.ui.Button) -> None:
        if not self.cog.user_can_manage(interaction):
            await self.cog.send_ephemeral_message(interaction, content='Apenas ADM/gerência pode cadastrar veículos.')
            return
        await interaction.response.send_modal(VehicleRegisterModal(self.cog))

