        except FinanceApiError as exc:
            await self.cog.send_ephemeral_message(interaction, content=f'Falha ao carregar veículos para remoção: {exc}')

    @discord.ui.button(label='Reativar Veículo', style=discord.ButtonStyle.success, emoji='♻️', custom_id='vehicles:reactivate')
